# InterfaceConfig.ini - Configurazione Interfaccia Utente
# Posizionato alla stessa directory di home_config.ini
#
# Questo file permette di configurare gli elementi dell'interfaccia
# senza modificare il codice sorgente.

[ResetCameraButton]
# Posizione del pulsante di reset vista camera
# Valori: top-right | top-left | top-center | bottom-right | bottom-left | bottom-center
Position=bottom-right

[CameraControls]
# Inverti la direzione verticale della rotazione camera (su/giu)
# true  = movimento mouse su   → camera va su   (stile "normale")
# false = movimento mouse giu' → camera va su   (stile "inverso", default)
InvertVertical=true
# Inverti la direzione orizzontale della rotazione camera (sinistra/destra)
# true  = movimento mouse destra → camera ruota a sinistra
# false = movimento mouse destra → camera ruota a destra (default)
InvertHorizontal=false

# --- Zoom Pinch (touch) ---
# Sensibilita' del pinch-to-zoom (default: 0.003 | range consigliato: 0.001 - 0.010)
PinchSensitivity=0.001
# Inverti il senso del pinch-to-zoom
# false = apertura dita → avvicina (zoom in)   [default, comportamento naturale]
# true  = apertura dita → allontana (zoom out)
InvertPinchZoom=false

# --- Zoom Scroll (mouse) ---
# Sensibilita' dello scroll wheel (default: 0.025 | range consigliato: 0.010 - 0.060)
ScrollSensitivity=0.01
# Inverti il senso dello scroll
# false = scroll giu' → allontana (zoom out)   [default]
# true  = scroll giu' → avvicina (zoom in)
InvertScrollZoom=false

# --- Limiti Zoom ---
# Distanza minima camera dal pivot (quanto ci si puo' avvicinare)
# default: 0.15  |  valori tipici: 0.05 (vicinissimo) - 1.0 (distante)
ZoomMin=0.4
# Distanza massima camera dal pivot (quanto ci si puo' allontanare)
# default: 15    |  valori tipici: 5 (vicino) - 50 (lontano)
ZoomMax=1.3

[SpeechBubble]
# Durata dell'animazione drammatica del fumetto (ms) quando HighlightDescription=true
# default: 1000 | range consigliato: 500 - 3000
DramaticAnimationDuration=1300
