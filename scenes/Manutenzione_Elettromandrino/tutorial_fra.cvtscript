# TUTORIAL: Manutenzione Elettromandrino - lubrificazione
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Maintenance de l'électrobroche - Lubrification"]
camera = position (0.97, 1.25, 3.92), target (0.97, 1.15, 3.52), rotation (-0.24, 0, 0), pivot (0.97, 1.15, 3.52), distance 0.42, fov 75.0, fade 2.0

[step "Aller à l'écran MDI" highlight]
description = Appuyez sur le bouton MDI du pupitre pour accéder au mode de contrôle manuel.
element     = pulpito.Pulsante_mdi
after       : schermo = schermo002

[step "Décharger l'outil" highlight]
description = Appuyez sur le bouton à l'écran pour effectuer le déchargement de l'outil T=1000.
element     = pulpito.Pulsante_tool
after       : schermo = schermo003

[step "Prendre la télécommande Tecpad" highlight]
description = Prenez la télécommande Tecpad.
camera = position (1.17, 1.15, 4.12), target (1.02, 0.83, 3.63), pivot (1.02, 0.83, 3.63), zoom 0.59, fov 75, rotation (-0.58, 0.25, 0.16), fade 1.0
tool        = hand
hold        = pick remote at (-0.25, -0.07, 0.25) facing (0, 5, 0)
view        = main

[step "Appuyer sur le bouton démarrer" highlight]
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
description = Appuyez sur le bouton Démarrer de la télécommande pour lancer le déchargement de l'outil.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo004

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 2: SEQUENZA SCARICO UTENSILE (automatica)
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Mouvement du chariot Y" machine]
element = a500.Basamento_Portale_CarroY
do      : move by (0, 0, 2.623) duration 1.5

[step "Descente du prisme" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, -0.085, 0) duration 1.0

[step "Ouverture du magasin" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (0.565, 0, 0) duration 1.0

[step "Changement d'outil" machine]
after : tool = tool0

[step "Remontée du prisme" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, 0.085, 0) duration 1.0

[step "Fermeture du magasin" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (-0.565, 0, 0) duration 1.0
after   : schermo = schermo002

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 3: SELEZIONE TESTA E SBLOCCO PINZA
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Bouton WH" highlight]
description = Appuyez sur le bouton à l'écran pour sélectionner les têtes.
camera      = position (0.95, 1.21, 3.91), target (0.97, 1.15, 3.52), rotation (-0.16, -0.05, -0.01), pivot (0.97, 1.15, 3.52), distance 0.4, fov 75, fade 2.0
element     = pulpito.Pulsante_WH
after       : schermo = schermo008

[step "Bouton électrobroche"]
description = Appuyez sur le bouton à l'écran pour sélectionner l'électrobroche.
element     = pulpito.Pulsante_electrospindle
after       : schermo = schermo009

[step "Activation du déverrouillage"]
description = Appuyez sur le bouton à l'écran pour activer le déverrouillage du mandrin de l'électrobroche.
element     = pulpito.Pulsante_LU
after       : schermo = schermo010

[step "Appuyer sur le bouton démarrer pour le déverrouillage" highlight]
description = Appuyez sur le bouton Démarrer de la télécommande pour activer le déverrouillage du mandrin de l'électrobroche.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo011

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 4: ACCESSO FISICO ALL'ELETTROMANDRINO
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Tourner la clé" highlight]
description = Tournez la clé pour ouvrir la porte d'accès à l'électrobroche.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave0
after       : chiave = chiave1; schermo = schermo005; start = pstart0

[step "Ouvrir physiquement la porte" highlight]
description = Ouvrez la porte de la cabine pour accéder à l'électrobroche.
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0.615, 0, 0) by (0, 90, 0) duration 1.0

[step "Regarder vers le nez de l'électrobroche" highlight, machine]
description = Positionnez-vous pour regarder vers le nez de l'électrobroche ; si nécessaire, déplacez d'abord manuellement l'axe Y vers vous.
camera      = position (2.74, 1.34, 2.45), target (2.79, 1.27, 1.99), rotation (-0.16, -0.11, -0.02), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, fade 2.0

[step "Lubrifier avec le spray"]
tool        = spray
description = Utilisez le spray lubrifiant pour graisser le nez de l'électrobroche.
message     = Utilisez le spray lubrifiant pour graisser le nez de l'électrobroche.
title       = ⚠️ Important
video       = media/lubelett.mp4
# Camera sbloccata per questo step
camera      = position (2.78, 0.91, 2.29), target (2.79, 1.27, 1.99), rotation (0.87, -0.03, 0.04), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, free within (-3.14, 3.14)
element     = a500.naso
do          : move by (0, 0, 0) duration 0.5

[step "Changer d'écran sur le Tecpad" highlight]
description = Appuyez sur le bouton du Tecpad pour changer l'écran en statut.
tool        = hand
element     = remote.Pulsante_r_status
after       : schermo_remote = Schermo_R001

[step "Ouvrir et fermer" highlight]
tool        = hand
description = Ouvrez et fermez plusieurs fois en appuyant sur le bouton déverrouiller (4 cycles).
element     = remote.Pulsante_r_unlock repeat 8
animation   = folder screens/mandrino at (60%, 60%) frame 20ms

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 5: CHIUSURA E RIACCENSIONE
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Fermer physiquement la porte" highlight]
description = Refermez la porte de la cabine pour accéder à l'électrobroche.
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0, 0, -0.615) by (0, -90, 0) duration 1.0

[step "Aller au pupitre et tourner la clé en fermeture" highlight]
description = Allez au pupitre et tournez la clé en position de fermeture.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave1
after       : chiave = chiave0

[step "Redémarrer la machine" highlight]
description = Appuyez sur le bouton de démarrage pour redémarrer la machine.
tool        = hand
element     = pulpito.pstart0
after       : start = pstart1; schermo = schermo002
