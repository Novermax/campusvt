# ═══════════════════════════════════════════════════════════════════════════
# ELECTROSPINDLE MAINTENANCE - Tutorial with StateGroups
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# GLOBAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

CameraPos=(1.01, 1.22, 3.87)
CameraTarget=(0,0,0)
CameraRotation=(-0.26, -0.01, 0)
CameraPivot=(1.02, 1.1, 3.4)
CameraDistance=1.24
CameraFOV=75.0
CameraTransitionTime=2.0

# ═══════════════════════════════════════════════════════════════════════════
# STATE GROUPS - Mutually exclusive variants
# ═══════════════════════════════════════════════════════════════════════════

# Ignition key: two states (off/on)
[StateGroup:chiave]
Variants=chiave0,chiave1
Default=chiave0

# Start button: two states (off/on)
[StateGroup:start]
Variants=pstart0,pstart1
Default=pstart1

# Emergency: two states (off/on)
[StateGroup:emergenza]
Variants=emergenza_off,emergenza_on
Default=emergenza_off

# Screens: variants (home/mdi/tool/running)
[StateGroup:schermo]
Variants=schermo001,schermo002,schermo003,schermo004,schermo007,schermo008,schermo009,schermo010,schermo011
Default=schermo001

[StateGroup:schermo_remote]
Variants=Schermo_R000,Schermo_R001
Default=Schermo_R000

# Tool: two variants, tool1 on the electrospindle and tool0 in the magazine
[StateGroup:tool]
Variants=tool0,tool1
Default=tool1

# ═══════════════════════════════════════════════════════════════════════════
# INTERACTIVE OBJECT DEFINITION: CONTROL PANEL
# ═══════════════════════════════════════════════════════════════════════════

[InteractiveObject:pulpito]
Model=models/pulpito.glb

# Rotating key - click changes StateGroup "chiave" variant
InteractiveChild=chiave0,button,onClick:cycleVariant:chiave,opacity:1.0
InteractiveChild=chiave1,button,onClick:cycleVariant:chiave,opacity:1.0

# Screen navigation buttons - change StateGroup "schermo" variant
InteractiveChild=Pulsante_mdi,button,onClick:setVariant:schermo=schermo002,opacity:1.0
InteractiveChild=Pulsante_tool,button,onClick:setVariant:schermo=schermo003,opacity:1.0
InteractiveChild=Pulsante_WH,button,onClick:setVariant:schermo=schermo008,opacity:1.0
InteractiveChild=Pulsante_electrospindle,button,onClick:setVariant:schermo=schermo009,opacity:1.0
InteractiveChild=Pulsante_LU,button,onClick:setVariant:schermo=schermo010,opacity:1.0

# Emergency mushroom button - changes StateGroup "emergenza" variant
InteractiveChild=emergenza_off,button,onClick:setVariant:emergenza=emergenza_on,opacity:1.0
InteractiveChild=emergenza_on,button,onClick:setVariant:emergenza=emergenza_off,opacity:1.0

# Start button - changes StateGroup "start" variant
InteractiveChild=pstart0,button,onClick:cycleVariant:start,opacity:1.0
InteractiveChild=pstart1,button,onClick:cycleVariant:start,opacity:1.0

# ═══════════════════════════════════════════════════════════════════════════
# INTERACTIVE OBJECT DEFINITION: REMOTE (REMOTE CONTROL)
# ═══════════════════════════════════════════════════════════════════════════

[InteractiveObject:remote]
Model=models/remote.glb

# Play button on the remote control
InteractiveChild=pulsante_r_play,button,onClick:setVariant:start=pstart1,opacity:1.0

# Status button on the remote control
InteractiveChild=Pulsante_r_status,button,onClick:setVariant:schermo_remote=Schermo_R001,opacity:1.0

# Unlock button on the remote control (for open/close animation)
InteractiveChild=Pulsante_r_unlock,button,opacity:1.0

# ═══════════════════════════════════════════════════════════════════════════
# INTERACTIVE OBJECT DEFINITION: A500 MACHINE
# ═══════════════════════════════════════════════════════════════════════════

[InteractiveObject:a500]
Model=models/a500.glb

# Tool variants - tool on the electrospindle (tool1) and in the magazine (tool0)
# These must correspond to the child names in the a500.glb GLB file

# ═══════════════════════════════════════════════════════════════════════════
# TOOL MODELS - Managed by StateGroup "tool"
# ═══════════════════════════════════════════════════════════════════════════

# Tool1: tool mounted on the electrospindle (visible at start)
Elemento=models/utensile.glb
Posizione=utensile:(2.8, 2.5, -0.7)
Rotazione=utensile:(0, 0, 0)

# Tool0: same tool but in the magazine (hidden at start, visible after unloading)
# Note: the system automatically renames to tool0/tool1 for the StateGroup
# For now tool0 is hidden and will be shown by the AutoSetVariant step

# ═══════════════════════════════════════════════════════════════════════════
# TUTORIAL
# ═══════════════════════════════════════════════════════════════════════════

[Electrospindle Maintenance - lubrication]
CameraPos=(0.97, 1.25, 3.92)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.24, 0, 0)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.42
CameraFOV=75.0
CameraTransitionTime=2.0


[Step 1 - Go to the MDI screen]
HighlightDescription=true
Descrizione=Press the MDI button on the control panel to access the manual control mode.
CameraPos=(0.97, 1.25, 3.92)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.24, 0, 0)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.42
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the modified MDI button
ActiveButtons=Pulsante_mdi
AcceptTrigger_Physical=pulpito.Pulsante_mdi
OnPhysicalTrigger=setVariant:schermo=schermo002
AutoAdvance=true

[Next Step - Unload the tool]
HighlightDescription=true
Descrizione=Press the on-screen button to unload tool T=1000.
CameraPos=(0.97,1.22,3.8)
CameraTarget=(0.97,1.15,3.52)
CameraRotation=(-0.25, -0.01, 0)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=1.24
CameraFOV=55.0
CameraTransitionTime=2.0
# Trigger: click on the Tool button
ActiveButtons=Pulsante_tool
AcceptTrigger_Physical=pulpito.Pulsante_tool
OnPhysicalTrigger=setVariant:schermo=schermo003
AutoAdvance=true

[Next Step - Pick up the Tecpad remote control]
HighlightDescription=true
Descrizione=Pick up the Tecpad remote control
CameraPos=(0.94, 1.29, 4.07)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.25, -0.04, -0.01)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.56
CameraFOV=75.0
CameraTransitionTime=2.0
Utensile=Mani
Elemento=models/remote.glb
HoldAction=pick
Holdable=true
HoldPosition=(-0.25,-0.07,0.25)
HoldRotation=(0,5,0)
DefaultView=main
CameraDistance=0.5

[Next Step - Press the start button]
HighlightDescription=true
CameraPos=(2.52, 1.3, 4.55)
CameraTarget=(2.37, 1.15, 3.6)
CameraRotation=(-0.16, 0.15, 0.02)
CameraPivot=(2.37, 1.15, 3.6)
CameraDistance=0.98
CameraFOV=75.0
CameraTransitionTime=2.0
Descrizione=Press the Start button on the remote control to start the tool unloading.
Utensile=Mani
# Trigger: click on the play button of the remote control
ActiveButtons=pulsante_r_play
AcceptTrigger_Physical=remote.pulsante_r_play
OnPhysicalTrigger=setVariant:schermo=schermo004
AutoAdvance=true




# ───────────────────────────────────────────────────────────────────────────
# PHASE 2: TOOL UNLOADING SEQUENCE (AutoExecute)
# ───────────────────────────────────────────────────────────────────────────

[Next Step - Y Carriage Movement]
#Descrizione=The Y carriage moves to the tool change position...
Elemento=models/a500.glb
TargetChild=Basamento_Portale_CarroY
Azione1=traslazione:(0,0,2.623,1.5)
AutoExecute=true
AutoAdvance=true

[Next Step - Prism Descent]
#Descrizione=The prism descends towards the tool magazine...
Elemento=models/a500.glb
TargetChild=Basamento_Portale_CarroY_CarroZ_Prisma
Azione1=traslazione:(0,-0.085,0,1.0)
AutoExecute=true
AutoAdvance=true

[Next Step - Magazine Opening]
#Descrizione=The tool magazine opens...
Elemento=models/a500.glb
TargetChild=Basamento_Portale_MagazzinoInternoX1
Azione1=traslazione:(0.565,0,0,1.0)
AutoExecute=true
AutoAdvance=true

[Next Step - Tool Exchange]
#Descrizione=The tool is unloaded into the magazine...
AutoSetVariant=tool=tool0
AutoExecute=true
AutoAdvance=true

[Next Step - Prism Rise]
#Descrizione=The prism rises slightly...
Elemento=models/a500.glb
TargetChild=Basamento_Portale_CarroY_CarroZ_Prisma
Azione1=traslazione:(0,0.085,0,1.0)
AutoExecute=true
AutoAdvance=true

[Next Step - Magazine Closing]
#Descrizione=The tool magazine closes...
Elemento=models/a500.glb
TargetChild=Basamento_Portale_MagazzinoInternoX1
Azione1=traslazione:(-0.565,0,0,1.0)
AutoExecute=true
AutoAdvance=true
AutoSetVariant=schermo=schermo002

[Next Step - WH button]
HighlightDescription=true
Descrizione=Press the on-screen button to select the heads
CameraPos=(0.95,1.21,3.91)
CameraTarget=(0.97,1.15,3.52)
CameraRotation=(-0.16,-0.05,-0.01)
CameraPivot=(0.97,1.15,3.52)
CameraDistance=0.4
CameraFOV=75
CameraTransitionTime=2.0
# Trigger: click on the Tool button
ActiveButtons=Pulsante_WH
AcceptTrigger_Physical=pulpito.Pulsante_WH
OnPhysicalTrigger=setVariant:schermo=schermo008
AutoAdvance=true

[Next Step - electrospindle button]
HighlightDescription=true
Descrizione=Press the on-screen button to select the electrospindle
CameraPos=(0.95,1.21,3.91)
CameraTarget=(0.97,1.15,3.52)
CameraRotation=(-0.16,-0.05,-0.01)
CameraPivot=(0.97,1.15,3.52)
CameraDistance=0.4
CameraFOV=75
CameraTransitionTime=2.0
# Trigger: click on the Tool button
ActiveButtons=Pulsante_electrospindle
AcceptTrigger_Physical=pulpito.Pulsante_electrospindle
OnPhysicalTrigger=setVariant:schermo=schermo009
AutoAdvance=true




[Next Step - unlock enable]
HighlightDescription=true
Descrizione=Press the on-screen button to enable the unlocking of the electrospindle collet
CameraPos=(0.95,1.21,3.91)
CameraTarget=(0.97,1.15,3.52)
CameraRotation=(-0.16,-0.05,-0.01)
CameraPivot=(0.97,1.15,3.52)
CameraDistance=0.4
CameraFOV=75
CameraTransitionTime=2.0
# Trigger: click on the Tool button
ActiveButtons=Pulsante_LU
AcceptTrigger_Physical=pulpito.Pulsante_LU
OnPhysicalTrigger=setVariant:schermo=schermo010
AutoAdvance=true

[Next Step - Press the start button to unlock]
HighlightDescription=true

Descrizione=Press the Start button on the remote control to enable the unlocking of the electrospindle collet.
Utensile=Mani
# Trigger: click on the play button of the remote control
ActiveButtons=pulsante_r_play
AcceptTrigger_Physical=remote.pulsante_r_play
OnPhysicalTrigger=setVariant:schermo=schermo011
AutoAdvance=true


[Next Step - turn the key]
HighlightDescription=true
Descrizione=Turn the key to open the access door to the electrospindle.
Utensile=Mani
CameraPos=(0.94, 1.29, 4.07)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.25, -0.04, -0.01)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.56
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the control panel key (only chiave0 because it is the one visible at the start)
ActiveButtons=chiave0
AcceptTrigger_Physical=pulpito.chiave0
OnPhysicalTrigger=setVariant:chiave=chiave1;setVariant:schermo=schermo005;setVariant:start=pstart0

[Next Step - open the door physically]
HighlightDescription=true
Descrizione=Open the cabin door for access to the electrospindle.
Utensile=Mani
CameraPos=(2.52, 1.3, 4.55)
CameraTarget=(2.37, 1.15, 3.6)
CameraRotation=(-0.16, 0.15, 0.02)
CameraPivot=(2.37, 1.15, 3.6)
CameraDistance=0.98
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the control panel key (accepts both chiave0/chiave1 variants)
Elemento=models/a500.glb
TargetChild=porta
AcceptTrigger_Physical=a500.porta
Azione1=centro:(0.615,0,0);rotazione:(0,90,0,1.0)

[Next Step - look towards the nose of the electrospindle]
HighlightDescription=true
descrizione=Position yourself to look towards the nose of the electrospindle, if necessary first manually move the Y axis towards you
CameraPos=(2.74, 1.34, 2.45)
CameraTarget=(2.79, 1.27, 1.99)
CameraRotation=(-0.16, -0.11, -0.02)
CameraPivot=(2.79, 1.27, 1.99)
CameraDistance=0.47
CameraFOV=75.0
CameraTransitionTime=2.0
AutoExecute=true
AutoAdvance=true

[Next Step - lubricate with the spray]
HighlightDescription=false
Utensile=Spray
Descrizione=Use the lubricating spray to grease the nose of the electrospindle.
Message=Use the lubricating spray to grease the nose of the electrospindle.
MessageTitle=⚠️ Important
MessageVideo=media/lubelett.mp4

# Camera unlocked for this step
CameraUnlocked=true


CameraLimits=(-3.14, 3.14)                    # minPhi, maxPhi in radians
CameraPos=(2.78, 0.91, 2.29)
CameraTarget=(2.79, 1.27, 1.99)
CameraRotation= (0.87, -0.03, 0.04)
CameraPivot=(2.79, 1.27, 1.99)
CameraDistance=0.47
CameraFOV=75.0
Elemento=models/a500.glb
TargetChild=naso
Azione1=traslazione:(0,0,0,0.5)

[Next Step - change screen on the tecpad]
HighlightDescription=true
Descrizione=Press the button on the tecpad to change screen to status
Utensile=Mani
# Trigger: click on the pulsante_r_status button
ActiveButtons=Pulsante_r_status
AcceptTrigger_Physical=remote.Pulsante_r_status
OnPhysicalTrigger=setVariant:schermo_remote=Schermo_R001
AutoAdvance=true

[Next Step - open and close]
HighlightDescription=true
Elemento=models/remote.glb
Utensile=Mani
Descrizione=Open and close multiple times by pressing the unlock button (4 cycles)
ActiveButtons=Pulsante_r_unlock
AcceptTrigger_Physical=remote.Pulsante_r_unlock
AnimatedImagesFolder=screens/mandrino
AnimatedPosition=(60%,60%)
AnimatedMaxTriggers=8
AnimatedFrameDelay=20




[Next Step - close the door physically]
HighlightDescription=true
Descrizione=Close the cabin door for access to the electrospindle.
Utensile=Mani
CameraPos=(2.52, 1.3, 4.55)
CameraTarget=(2.37, 1.15, 3.6)
CameraRotation=(-0.16, 0.15, 0.02)
CameraPivot=(2.37, 1.15, 3.6)
CameraDistance=0.98
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the control panel key (accepts both chiave0/chiave1 variants)
Elemento=models/a500.glb
TargetChild=porta
AcceptTrigger_Physical=a500.porta
Azione1=centro:(0,0,-0.615);rotazione:(0,-90,0,1.0)

[Next Step - Go to the control panel and turn the key to close]
HighlightDescription=true
Descrizione=Go to the control panel and turn the key to close.
Utensile=Mani
CameraPos=(0.94, 1.29, 4.07)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.25, -0.04, -0.01)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.56
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the control panel key (only chiave1 because it is the one visible after opening it)
ActiveButtons=chiave1
AcceptTrigger_Physical=pulpito.chiave1
OnPhysicalTrigger=setVariant:chiave=chiave0



[Next Step - Restart the machine]
HighlightDescription=true
Descrizione=Press the power button to restart the machine.
Utensile=Mani
CameraPos=(0.94, 1.29, 4.07)
CameraTarget=(0.97, 1.15, 3.52)
CameraRotation=(-0.25, -0.04, -0.01)
CameraPivot=(0.97, 1.15, 3.52)
CameraDistance=0.56
CameraFOV=75.0
CameraTransitionTime=2.0
# Trigger: click on the start button (only pstart0 because it is the one visible after turning the key)
ActiveButtons=pstart0
AcceptTrigger_Physical=pulpito.pstart0
OnPhysicalTrigger=setVariant:start=pstart1;setVariant:schermo=schermo002
AutoAdvance=true

