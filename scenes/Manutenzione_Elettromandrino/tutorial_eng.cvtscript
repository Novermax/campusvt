# MANUTENZIONE ELETTROMANDRINO - Tutorial CVTScript v3
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# CONFIGURAZIONE GLOBALE
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[scene]
camera = position (1.01, 1.22, 3.87), target (0, 0, 0), rotation (-0.26, -0.01, 0), pivot (1.02, 1.1, 3.4), distance 1.24, fov 75.0, fade 2.0

# NOTE: Definizioni di [state ...] e [object ...] estratte in objects.ini
# (caricato automaticamente prima di questo file dal loader modulare).

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TUTORIAL: Manutenzione Elettromandrino - lubrificazione
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Electric Spindle Maintenance - Lubrication"]
camera = position (0.97, 1.25, 3.92), target (0.97, 1.15, 3.52), rotation (-0.24, 0, 0), pivot (0.97, 1.15, 3.52), distance 0.42, fov 75.0, fade 2.0

[step "Go to MDI Screen" highlight]
description = Press the MDI button on the console to access the manual control mode.
element     = pulpito.Pulsante_mdi
after       : schermo = schermo002

[step "Unload the Tool" highlight]
description = Press the on-screen button to perform the tool unload T=1000.
element     = pulpito.Pulsante_tool
after       : schermo = schermo003

[step "Pick Up the Tecpad Remote" highlight]
description = Pick up the Tecpad remote control.
camera = position (1.17, 1.15, 4.12), target (1.02, 0.83, 3.63), pivot (1.02, 0.83, 3.63), zoom 0.59, fov 75, rotation (-0.58, 0.25, 0.16), fade 1.0
tool        = hand
hold        = pick remote at (-0.25, -0.07, 0.25) facing (0, 5, 0)
view        = main

[step "Press the Start Button" highlight]
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
description = Press the Start button on the remote control to start the tool unload.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo004

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 2: SEQUENZA SCARICO UTENSILE (automatica)
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Y-Carriage Movement" machine]
element = a500.Basamento_Portale_CarroY
do      : move by (0, 0, 2.623) duration 1.5

[step "Prism Descent" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, -0.085, 0) duration 1.0

[step "Magazine Opening" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (0.565, 0, 0) duration 1.0

[step "Tool Change" machine]
after : tool = tool0

[step "Prism Ascent" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, 0.085, 0) duration 1.0

[step "Magazine Closing" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (-0.565, 0, 0) duration 1.0
after   : schermo = schermo002

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 3: SELEZIONE TESTA E SBLOCCO PINZA
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "WH Button" highlight]
description = Press the on-screen button to select the heads.
camera      = position (0.95, 1.21, 3.91), target (0.97, 1.15, 3.52), rotation (-0.16, -0.05, -0.01), pivot (0.97, 1.15, 3.52), distance 0.4, fov 75, fade 2.0
element     = pulpito.Pulsante_WH
after       : schermo = schermo008

[step "Electric Spindle Button"]
description = Press the on-screen button to select the electric spindle.
element     = pulpito.Pulsante_electrospindle
after       : schermo = schermo009

[step "Unlock Enable"]
description = Press the on-screen button to enable the electric spindle chuck unlock.
element     = pulpito.Pulsante_LU
after       : schermo = schermo010

[step "Press Start Button for Unlock" highlight]
description = Press the Start button on the remote control to enable the electric spindle chuck unlock.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo011

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 4: ACCESSO FISICO ALL'ELETTROMANDRINO
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Turn the Key" highlight]
description = Turn the key to open the electric spindle access door.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave0
after       : chiave = chiave1; schermo = schermo005; start = pstart0

[step "Open the Door Physically" highlight]
description = Open the cabin door to access the electric spindle.
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0.615, 0, 0) by (0, 90, 0) duration 1.0

[step "Look Towards the Electric Spindle Nose" highlight, machine]
description = Position yourself to look towards the electric spindle nose; if necessary, first manually move the Y axis towards you.
camera      = position (2.74, 1.34, 2.45), target (2.79, 1.27, 1.99), rotation (-0.16, -0.11, -0.02), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, fade 2.0

[step "Lubricate with Spray"]
tool        = spray
description = Use the lubricant spray to grease the electric spindle nose.
message     = Use the lubricant spray to grease the electric spindle nose.
title       = ⚠️ Important
video       = media/lubelett.mp4
# Camera sbloccata per questo step
camera      = position (2.78, 0.91, 2.29), target (2.79, 1.27, 1.99), rotation (0.87, -0.03, 0.04), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, free within (-3.14, 3.14)
element     = a500.naso
do          : move by (0, 0, 0) duration 0.5

[step "Change Screen on Tecpad" highlight]
description = Press the button on the Tecpad to change the screen to status.
tool        = hand
element     = remote.Pulsante_r_status
after       : schermo_remote = Schermo_R001

[step "Open and Close" highlight]
tool        = hand
description = Open and close several times by pressing the unlock button (4 cycles).
element     = remote.Pulsante_r_unlock repeat 8
animation   = folder screens/mandrino at (60%, 60%) frame 20ms

# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€
# FASE 5: CHIUSURA E RIACCENSIONE
# â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€

[step "Close the Door Physically" highlight]
description = Close the cabin door for access to the electric spindle.
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0, 0, -0.615) by (0, -90, 0) duration 1.0

[step "Go to the Console and Turn the Key to Close" highlight]
description = Go to the console and turn the key to the closed position.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave1
after       : chiave = chiave0

[step "Restart the Machine" highlight]
description = Press the power button to restart the machine.
tool        = hand
element     = pulpito.pstart0
after       : start = pstart1; schermo = schermo002
