# TUTORIAL: Manutenzione Elettromandrino - lubrificazione
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Manutenzione Elettromandrino - lubrificazione"]
camera = position (0.97, 1.25, 3.92), target (0.97, 1.15, 3.52), rotation (-0.24, 0, 0), pivot (0.97, 1.15, 3.52), distance 0.42, fov 75.0, fade 2.0

[step "Vai alla schermata MDI" highlight]
description = Premi il pulsante MDI sul pulpito per accedere alla modalità di controllo manuale.
element     = pulpito.Pulsante_mdi
after       : schermo = schermo002

[step "Scarica l'utensile" highlight]
description = Premi il pulsante a video per eseguire lo scarico dell'utensile T=1000.
element     = pulpito.Pulsante_tool
after       : schermo = schermo003

[step "Prendi il telecomando Tecpad" highlight]
description = Prendi il telecomando Tecpad
camera = position (1.17, 1.15, 4.12), target (1.02, 0.83, 3.63), pivot (1.02, 0.83, 3.63), zoom 0.59, fov 75, rotation (-0.58, 0.25, 0.16), fade 1.0
tool        = hand
hold        = pick remote at (-0.2, -0.0, 0.25) facing (0, 5, 0)
view        = main

[step "Premi il pulsante start" highlight]
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
description = Premi il pulsante Start sul telecomando per avviare lo scarico utensile.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo004

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# FASE 2: SEQUENZA SCARICO UTENSILE (automatica)
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

[step "Movimento CarroY" machine]
element = a500.Basamento_Portale_CarroY
do      : move by (0, 0, 2.623) duration 1.5

[step "Discesa Prisma" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, -0.085, 0) duration 1.0

[step "Apertura Magazzino" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (0.565, 0, 0) duration 1.0

[step "Scambio Utensile" machine]
after : tool = tool0

[step "Risalita Prisma" machine]
element = a500.Basamento_Portale_CarroY_CarroZ_Prisma
do      : move by (0, 0.085, 0) duration 1.0

[step "Chiusura Magazzino" machine]
element = a500.Basamento_Portale_MagazzinoInternoX1
do      : move by (-0.565, 0, 0) duration 1.0
after   : schermo = schermo002

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# FASE 3: SELEZIONE TESTA E SBLOCCO PINZA
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

[step "pulsante WH" highlight]
description = Premi il pulsante a video per selezionare le teste
camera      = position (0.95, 1.21, 3.91), target (0.97, 1.15, 3.52), rotation (-0.16, -0.05, -0.01), pivot (0.97, 1.15, 3.52), distance 0.4, fov 75, fade 2.0
element     = pulpito.Pulsante_WH
after       : schermo = schermo008

[step "pulsante elettromandrino"]
description = Premi il pulsante a video per selezionare l'elettromandrino
element     = pulpito.Pulsante_electrospindle
after       : schermo = schermo009

[step "abilitazione sblocco"]
description = Premi il pulsante a video per abilitare lo sblocco della pinza dell'elettromandrino
element     = pulpito.Pulsante_LU
after       : schermo = schermo010

[step "Premi il pulsante start per lo sblocco" highlight]
description = Premi il pulsante Start sul telecomando per abilitare lo sblocco della pinza dell'elettromandrino.
tool        = hand
element     = remote.pulsante_r_play
after       : schermo = schermo011

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# FASE 4: ACCESSO FISICO ALL'ELETTROMANDRINO
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

[step "Gira la chiave" highlight]
description = Gira la chiave per aprire la porta di accesso all'elettromandrino.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave0
after       : chiave = chiave1; schermo = schermo005; start = pstart0

[step "Apri la porta fisicamente" highlight]
description = Apri la porta della cabina per l'accesso all'elettromandrino.
camera      = position (2.52, 1.3, 4.55), target (2.37, 1.15, 3.6), rotation (-0.16, 0.15, 0.02), pivot (2.37, 1.15, 3.6), distance 0.98, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0.615, 0, 0) by (0, 90, 0) duration 1.0

[step "Guarda verso il naso dell'elettromandrino" highlight, machine]
description = Posizionati per guardare verso il naso dell'elettromandrino, se necessario prima sposta manualmente l'asse Y verso di te
camera      = position (2.74, 1.34, 2.45), target (2.79, 1.27, 1.99), rotation (-0.16, -0.11, -0.02), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, fade 2.0

[step "Ingrassa con lo spray"]
tool        = spray
description = Usa lo spray lubrificante per ingrassare il naso dell'elettromandrino.
message     = Usa lo spray lubrificante per ingrassare il naso dell'elettromandrino.
title       = ⚠️ Importante
video       = media/lubelett.mp4
# Camera sbloccata per questo step
camera      = position (2.78, 0.91, 2.29), target (2.79, 1.27, 1.99), rotation (0.87, -0.03, 0.04), pivot (2.79, 1.27, 1.99), distance 0.47, fov 75.0, free within (-3.14, 3.14)
element     = a500.naso
do          : move by (0, 0, 0) duration 0.5

[step "Cambia schermata sul tecpad" highlight]
description = Premi il pulsante sul tecpad per cambiare schermata in status
tool        = hand
element     = remote.Pulsante_r_status
after       : schermo_remote = Schermo_R001

[step "Apri e chiudi" highlight]
tool        = hand
description = Apri e chiudi più volte premendo il pulsante unlock (4 cicli)
element     = remote.Pulsante_r_unlock repeat 8
animation   = folder screens/mandrino at (60%, 60%) frame 20ms

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# FASE 5: CHIUSURA E RIACCENSIONE
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

[step "Chiudi la porta fisicamente" highlight]
description = Richiudi la porta della cabina per l'accesso all'elettromandrino.
camera      = position (2.13, 1.12, 4.5), pivot (2.63, 0.86, 3.33), distance 1.3, fov 75.0, fade 2.0
element     = a500.porta
do          : rotate around (0, 0, -0.615) by (0, -90, 0) duration 1.0

[step "Vai sul pulpito e ruota la chiave in chiusura" highlight]
description = Vai sul pulpito e ruota la chiave in chiusura.
tool        = hand
camera      = position (0.94, 1.29, 4.07), target (0.97, 1.15, 3.52), rotation (-0.25, -0.04, -0.01), pivot (0.97, 1.15, 3.52), distance 0.56, fov 75.0, fade 2.0
element     = pulpito.chiave1
after       : chiave = chiave0

[step "Riaccendi la macchina" highlight]
description = Premi il pulsante di accensione per riaccendere la macchina.
tool        = hand
element     = pulpito.pstart0
after       : start = pstart1; schermo = schermo002
