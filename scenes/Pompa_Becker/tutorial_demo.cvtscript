
# ============================================================
#  DEMO LIVE — "Da Zero a Tutorial in 5 Minuti"
#  Scenario: Pompa del Vuoto Becker
# ============================================================
#  Istruzioni per il presentatore:
#  - Parti da un file VUOTO nel Blocco Note
#  - Copia/incolla un blocco alla volta
#  - Dopo ogni blocco: Salva → Alt+Tab → F5
#  - Commenta ad alta voce cosa stai aggiungendo
# ============================================================

# Camera iniziale dello scenario
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=(0, 0, 0)
CameraTransitionTime=1.5

# ============================================================
#  BLOCCO 1 — "Bastano 4 righe"
#  Messaggio: il minimo per un tutorial funzionante
# ============================================================

[Demo Live]

[Step 1 - Svita la prima vite]
Elemento=models/vite_coperchio_1.glb
Utensile=Mani
Azione1=svita
Descrizione=Seleziona lo strumento "Mano" e clicca sulla vite per svitarla

# ============================================================
#  BLOCCO 2 — "Una riga per la camera, sembra un film"
#  Messaggio: zoom cinematografico automatico
# ============================================================

[Step 2 - Svita la seconda vite]
Elemento=models/vite_coperchio_2.glb
Utensile=Mani
Azione1=svita
Descrizione=Svita la seconda vite del coperchio
CameraTarget=vite_coperchio_2
CameraDistance=0.4
CameraTransitionTime=1.5

# ============================================================
#  BLOCCO 3 — "Animazioni complesse in una riga"
#  Messaggio: traslazione + rotazione + appoggio a terra
# ============================================================

[Step 3 - Rimuovi il coperchio]
HighlightDescription=true
Elemento=models/coperchio.glb
Utensile=Mani
Descrizione=Rimuovi il coperchio del filtro
Azione1=traslazione:(-0.5,0,0.5,0.8)
Azione2=centro:(0,0.1,0);rotazione:(0,0,-90,0.8)
Azione3=appoggia(0.5)
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=coperchio
CameraDistance=0.8
CameraTransitionTime=1.2

# ============================================================
#  BLOCCO 4 — "Effetti speciali: aria compressa"
#  Messaggio: cambio utensile + particelle automatiche
# ============================================================

[Step 4 - Pulisci con aria compressa]
HighlightDescription=true
Elemento=models/filtro.glb
Utensile=Aria
Descrizione=Usa l'aria compressa per pulire il filtro
Azione1=traslazione:(0,0.01,0,0.5)
CameraTarget=filtro
CameraDistance=0.5
CameraTransitionTime=1.5

# ============================================================
#  BLOCCO 5 — "Drag & Drop con snap magnetico"
#  Messaggio: l'utente trascina, il sistema aggancia
# ============================================================

[Step 5 - Rimonta il coperchio]
HighlightDescription=true
Elemento=models/coperchio.glb
DragDrop=true
SnapTargets=corpo
DragDropDistance=1.5
Descrizione=Trascina il coperchio e riposizionalo sulla pompa
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=corpo
CameraDistance=0.8
CameraTransitionTime=1.2

# ============================================================
#  BLOCCO 6 — "Il gran finale: messaggio professionale"
#  Messaggio: chiusura tutorial con 3 righe
# ============================================================

[Step 6 - Operazione completata]
Message=Complimenti! \nHai completato con successo la pulizia del filtro della pompa del vuoto.\nRicorda: questa manutenzione va eseguita ogni 500 ore di funzionamento.
MessageTitle=Tutorial Completato
AutoExecute=true
