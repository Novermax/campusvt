[Next Step - Filter]
CameraPos=(-1.38,0.5,0.27)
CameraTarget=(-0.58,0.01,-0.16)
CameraRotation=(-0.86,-0.88,-0.73)
CameraPivot=(-0.58,0.01,-0.16)
CameraDistance=1.03
CameraFOV=75
CameraTransitionTime=1.0
HighlightDescription=true
Descrizione=Insert the filter into its seat.
Utensile=Mani

# Sequential assembly system - filter
DragDrop=true
# Only the filter can be mounted in this step
DragDropObjects=filtro
DragDropDistance=0.3


[Next Step - Lid]
HighlightDescription=true

Descrizione=Place the lid over the filter.
Utensile=Mani

# Continue sequential assembly - lid
DragDrop=true
DragDropObjects=coperchio
DragDropDistance=0.3



[Next Step - Lid Screws Group]
CameraPos=(-1.14,0.27,-0.04)
CameraTarget=(-0.32,0,-0.01)
CameraRotation=(-1.67,-1.25,-1.67)
CameraPivot=(-0.32,0,-0.01)
CameraDistance=0.86
CameraFOV=75
CameraTransitionTime=1.0
HighlightDescription=true

Descrizione=Mount the 4 lid screws in any order.
Utensile=Mani

# Interchangeable node - free order for screws
DragDrop=true
DragDropObjects=vite_coperchio_1,vite_coperchio_2,vite_coperchio_3,vite_coperchio_4

DragDropDistance=0.2



[Next Step - Final Greaser]
HighlightDescription=true

Descrizione=Finally, place the greaser back in its resting position. Requires all screws to be mounted.
Utensile=Mani

# Final step - requires all prerequisites
DragDrop=true
DragDropObjects=ingrassatore
DragDropDistance=0.3





[Vane Replacement Disassembly]
