
# Tutorial for Vacuum Pump Maintenance
# This file defines the guided sequence for filter replacement
# and lubrication of the Becker U5.40 vacuum pump
# Each section represents a step with specific actions and animations

CameraPos=(-1.5, 0.5,-0.2)                                       // Posizione assoluta per test
CameraTarget=(0, 0, 0)                                    // Focus su centro scena leggermente rialzato
CameraZoom=1.2                                                // Zoom leggero per visione d''insieme
CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
Posizione=planaxis:(-0.5,0.01,-0.5)                           // Posiziona modello specifico

[Filter Cleaning and Lubrication]                                            // Tutorial principale - sequenza di smontaggio
  CameraPos=(-1.5, 0.5,-0.2)                                       // Posizione assoluta per test
  CameraTarget=(0, 0, 0)                                    // Focus su centro scena leggermente rialzato
  CameraZoom=1.2                                                // Zoom leggero per visione d''insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
  Azione1=resetCenteredOriginal
  [Step 1 - First screw]
  HighlightDescription=true                                 // Primo step: rimozione prima vite
  Elemento=models/vite_coperchio_1.glb                         // Modello 3D della prima vite da animare
  Utensile=Mani                                            // Strumento richiesto: lavoro manuale
  Descrizione=Select the "Hand" tool and remove the first cover screw          // Testo mostrato nel fumetto laterale
  Azione1=svita
  Azione2=appoggia(0.2)


  [Next Step - Second screw]                                  // Secondo step: vite angolo superiore destro
  HighlightDescription=false                                 // Evidenzia la descrizione per il secondo step
  Elemento=models/vite_coperchio_2.glb                            // Modello della seconda vite
  Utensile=Mani                                            // Strumento: sempre manuale per le viti
  Descrizione=Remove the second cover screw        // Descrizione per l''utente
  Azione1=svita
  Azione2=appoggia(0.2)
Autoaction=true
  [Next Step - Third screw]                                    // Terzo step: vite angolo inferiore sinistro
  HighlightDescription=false
  Elemento=models/vite_coperchio_3.glb                            // Modello della terza vite
  Utensile=Mani                                            // Utensile: operazione manuale
  Descrizione=Remove the third cover screw          // Istruzione per l''operatore
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step - Fourth screw]                                   // Quarto step: ultima vite angolo inferiore destro
  HighlightDescription=false
  Elemento=models/vite_coperchio_4.glb                            // Modello dell''ultima vite del coperchio
  Utensile=Mani                                            // Strumento: operazione manuale
  Descrizione=Remove the fourth cover screw         // Istruzione finale per le viti
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step- Cover]                                     // Quinto step: rimozione coperchio completo
  HighlightDescription=true
  Elemento=models/coperchio.glb                                   // Modello del coperchio della pompa
  Utensile=Mani                                            // Strumento: sollevamento manuale
  Descrizione=Remove the filter cover              // Istruzione per rimozione coperchio
  Azione1=traslazione:(-0.5,0,0.5,0.8)
  Azione2=centro:(0,0.1,0);rotazione:(0,0,-90,0.8)                       // Estrazione coperchio 0.4 unità in 1.5 secondi
  Azione3=appoggia(0.5)




[Next Step - Filter]                                        // Sesto step: estrazione filtro usurato
HighlightDescription=true
Elemento=models/filtro.glb                                     // Modello 3D del filtro da sostituire
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Remove the filter                           // Istruzione per rimozione filtro
  Azione1=traslazione:(-0.3,0,0,1.5)
  Azione2=traslazione:(0,0,0.5,1.5)
  Azione3=appoggia(1.5)
  //Azione=estrai                                           // Animazione: estrazione lineare senza rotazione
  //Distanza=0.4                                            // Distanza di estrazione (filtro compatto)
  //Durata=1.5                                              // Durata personalizzata: estrazione rapida

 [Next Step - Compressed air]
 HighlightDescription=true
 Elemento=models/filtro.glb
  Descrizione=Clean the filter with compressed air
  CameraPos=(-0.2,0.33,0.74)                                      // Posizione assoluta per test
  CameraTarget=filtro                                  // Focus su centro scena leggermente rialzato
  CameraZoom=0.5                                               // Zoom leggero per visione d'insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
  Utensile=Aria
  Azione1=traslazione:(0,0.01,0,0.5)
  Azione2=appoggia(0.5)

[Next Step- Right cap]                                        // Sesto step: estrazione filtro usurato
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Posizione assoluta per test
  CameraTarget=tappino_grasso_dx                                    // Focus su centro scena leggermente rialzato
  CameraZoom=0.5                                           // Zoom leggero per visione d'insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce

  Elemento=models/tappino_grasso_dx.glb                                     // Modello 3D del filtro da sostituire
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Remove the protection cap from the right grease fitting       // Istruzione per rimozione filtro
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Estrazione tappino 0.3 unità
  Azione2=appoggia(0.5)


[Next Step - Left cap]                                        // Sesto step: estrazione filtro usurato
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Posizione assoluta per test
  CameraTarget=tappino_grasso_sx                                    // Focus su centro scena leggermente rialzato
  CameraZoom=0.5                                           // Zoom leggero per visione d'insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
  Elemento=models/tappino_grasso_sx.glb                                     // Modello 3D del filtro da sostituire
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Remove the protection cap from the left grease fitting       // Istruzione per rimozione filtro
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Estrazione tappino 0.3 unità
  Azione2=appoggia(0.5)


[Next Step - Grease pump]                                        // Nono step: movimento ingrassatore
HighlightDescription=false
Elemento=models/ingrassatore.glb                                     // Modello 3D dell'ingrassatore da animare
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Take the grease pump        // Istruzione per movimento
  Azione1=traslazione:(0,0.1,0,0.8)
  Azione2=centro:(-0.1,0,0);rotazione:(0,0,90,0.8)
  Azione3=traslazione:(-0.2,0.0,0,0.8)
  Azione4=appoggia(0.5)
  //CameraPos=ingrassatore:(-1, 0, 0)                    // Posizione relativa all'ingrassatore
  //CameraTarget=ingrassatore                               // Focus diretto sull'ingrassatore
  //CameraZoom=2.2                                          // Zoom alto per operazione di precisione
  //CameraTransitionTime=1.2                                // Transizione con easing dolce

[Next Step - Grease pump 2]                                        // Decimo step: movimento ingrassatore
HighlightDescription=true
CameraPos=(-0.42, 0.33,  0.3 )
  CameraTarget=(-0.28, 0.25,-0.16)                                       // Posizione assoluta per test
  CameraZoom=0.5                                           // Zoom leggero per visione d'insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce


  Elemento=models/ingrassatore.glb                                     // Modello 3D dell'ingrassatore da animare
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Apply grease to the right grease fitting by pumping 10 times     // Istruzione per movimento
  Azione1=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)
  Azione2=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione3=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione4=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione5=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione6=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione7=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione8=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione9=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione10=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione11=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione12=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione13=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione14=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione15=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione16=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione17=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione18=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione19=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
 Azione20=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)

  Azione21=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)


  //Azione22=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione22=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)

[Next Step - Grease pump 3]                                        // Decimo step: movimento ingrassatore
HighlightDescription=false

  Elemento=models/ingrassatore.glb                                     // Modello 3D dell'ingrassatore da animare
  Utensile=Mani                                           // Strumento: estrazione manuale
  Descrizione=Apply grease to the left grease fitting by pumping 10 times     // Istruzione per movimento
  Azione1=traslazione:tappino_grasso_sx_original,(-0.2,0.0,0,0.5)
  Azione2=traslazione:tappino_grasso_sx_original,(-0.08,0.0,0,0.1)
