[step "Reinstall Vane 1" highlight]
description = Pick up vane 1 and reinstall it in its original position. The vane will be rotated and positioned automatically.
tool        = hand
element     = paletta1
rotation    = paletta1 by (0.0, 0.0, 0.0)
do          : move by (0.625, 0.156, -0.300) duration 1.2
do          : move by (0, 0, -0.4) duration 1.2

[step "Reinstall Vane 2" auto]
camera      = position (-0.45, 0.45, 1.3), target (-0.7, 0.05, 0.61), rotation (-0.53, 0.31, 0.18), pivot (-0.7, 0.05, 0.61), distance 0.83, fov 75, fade 1.0, zoom 1
description = Pick up vane 2 and reinstall it in its original position. The vane will be rotated and positioned automatically.
tool        = hand
element     = paletta2
rotation    = paletta2 by (0.0, 0.0, 0.0)
do          : move by (0.958, -0.124, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Reinstall Vane 3" auto]
description = Pick up vane 3 and reinstall it in its original position. The vane will be positioned automatically.
tool        = hand
element     = paletta3
do          : move by (0.900, 0.273, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Reinstall Vane 4" auto]
description = Pick up vane 4 and reinstall it in its original position. The vane will be rotated and positioned automatically.
tool        = hand
element     = paletta4
rotation    = paletta4 by (0.0, 0.0, 0.0)
do          : move by (1.337, 0.082, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Reinstall Vane 5" auto]
description = Pick up vane 5 and reinstall it in its original position. The vane will be rotated and positioned automatically.
tool        = hand
element     = paletta5
rotation    = paletta5 by (0.0, 0.0, 0.0)
do          : move by (1.188, 0.151, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Position the Flange"]
description = Drag the flange and position it above its seat (it will snap automatically when lifted 0.3m).
tool        = hand
camera      = position (0, 0.45, 0.89), target (0, 0, 0), zoom 1.2, fade 1.5
drag        = flangia distance 0.3 snap pivot (0.000, 0.0, 0.3)

[step "Lower the Flange" highlight]
description = The flange will now be automatically lowered into its final position.
tool        = hand
element     = flangia
do          : move by (0.0, 0.0, -0.3) duration 0.8

[step "Place Flange Screw 1" highlight]
description = Place the first flange screw in its seat.
tool        = hand
camera      = position (0.01, 0.54, 0.79), target (0, 0.15, 0.19), rotation (-0.58, 0.02, 0.01), pivot (0, 0.15, 0.19), distance 0.72, fov 60, fade 1.0
drag        = vite_flangia_1 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 2" auto]
description = Place the second flange screw in its seat.
tool        = hand
drag        = vite_flangia_2 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 3" auto]
description = Place the third flange screw in its seat.
tool        = hand
drag        = vite_flangia_3 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 4" auto]
description = Place the fourth flange screw in its seat.
tool        = hand
drag        = vite_flangia_4 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 5" auto]
description = Place the fifth flange screw in its seat.
tool        = hand
drag        = vite_flangia_5 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 6" auto]
description = Place the sixth flange screw in its seat.
tool        = hand
drag        = vite_flangia_6 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 7" auto]
description = Place the seventh flange screw in its seat.
tool        = hand
drag        = vite_flangia_7 distance 1.5 snap offset (0, 0, 0.01)

[step "Place Flange Screw 8" auto]
description = Place the eighth flange screw in its seat.
tool        = hand
drag        = vite_flangia_8 distance 1.5 snap offset (0, 0, 0.01)

[step "Tighten Flange Screw 1" highlight]
element     = vite_flangia_1
description = Cross sequence (1/8): tighten screw 1 with the 10mm wrench.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 5"]
element     = vite_flangia_5
description = Cross sequence (2/8): tighten screw 5 - opposite to 1.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 3"]
element     = vite_flangia_3
description = Cross sequence (3/8): tighten screw 3.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 7"]
element     = vite_flangia_7
description = Cross sequence (4/8): tighten screw 7 - opposite to 3.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 2"]
element     = vite_flangia_2
description = Cross sequence (5/8): tighten screw 2.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 6"]
element     = vite_flangia_6
description = Cross sequence (6/8): tighten screw 6 - opposite to 2.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 4"]
element     = vite_flangia_4
description = Cross sequence (7/8): tighten screw 4.
tool        = wrench
do          : screw distance 0.01

[step "Tighten Flange Screw 8"]
element     = vite_flangia_8
description = Cross sequence (8/8): tighten screw 8 - opposite to 4.
tool        = wrench
do          : screw distance 0.01

[step "Reattach the Grease Tube"]
description = Connect the grease tube to the flange. Requires the flange to be already installed.
tool        = hand
drag        = tubograsso distance 0.3

[step "Reinstall the Cylinder Head" highlight]
camera      = position (-0.35, 0.42, 0.92), target (0.3, 0.12, 0.1), rotation (-0.35, -0.64, -0.22), pivot (0.3, 0.12, 0.1), distance 1.08, fov 75
description = Position the cylinder head on the pump body. Requires all flange screws to have been tightened.
tool        = hand
drag        = culatta distance 0.3

[step "Place Long Cylinder Head Screws" highlight]
description = Place the 2 long cylinder head screws in their seats in any order. The screws are not yet tightened.
tool        = hand
drag        = vite_culatta_1, vite_culatta_2 distance 1.5 snap offset (0, 0, 0.02)

[step "Place Short Cylinder Head Screws" highlight]
description = Place the 2 short cylinder head screws in their seats in any order. The screws are not yet tightened.
tool        = hand
drag        = vite_culatta_3, vite_culatta_4 distance 1.5 snap offset (0, 0, 0.02)

[step "Tighten Cylinder Head Screw 1" highlight]
element     = vite_culatta_1
description = Tighten the first cylinder head screw with the 6mm Allen key.
tool        = hex_key
do          : screw distance 0.02

[step "Tighten Cylinder Head Screw 2" auto]
element     = vite_culatta_2
description = Tighten the second cylinder head screw with the 6mm Allen key.
tool        = hex_key
do          : screw distance 0.02

[step "Tighten Cylinder Head Screw 3" auto]
element     = vite_culatta_3
description = Tighten the third cylinder head screw with the 6mm Allen key.
tool        = hex_key
do          : screw distance 0.02

[step "Tighten Cylinder Head Screw 4" auto]
element     = vite_culatta_4
description = Tighten the fourth cylinder head screw with the 6mm Allen key. This completes the pump reassembly.
tool        = hex_key
do          : screw distance 0.02
