[Next Step - Flange disassembly instructions]
HighlightDescription=true
  Message=Take two 8mm screws and insert them into the appropriate seats to use them as an extractor.
  MessageTitle=⚠️ Important
  MessageVideo=media/estrattore.mp4
  Descrizione=Flange extraction phase with extractor screws
  CameraPos=(0,0.45,0.89)
  CameraTarget=(0,0,0)
  CameraZoom=1
  DragDrop=true
  DragDropObjects=vite_culatta_1,vite_culatta_2  # Both draggable
  DragDropDistance=1.5                     # Snap distance in 3D units (increased to cover pivot-target distance ~1.4)
  SnapTargets=estrattoresx_original,estrattoredx_original # SIMPLIFIED SYNTAX: all objects can use all targets
  Utensile=Mani


[Next Step - Tighten extractor screws]
HighlightDescription=true
  DragDrop=false
CameraPos=(0, 0.37, 0.44)                                   // Posizione assoluta per test
  CameraTarget=(0, 0, 0)                                    // Focus su centro scena leggermente rialzato
  CameraZoom=0.5                                                // Zoom leggero per visione d'insieme
  CameraTransitionTime=1.0
 Descrizione=Tighten head screw 1 with the Allen key
 Utensile=ChiaveBrugola
 Elemento=models/vite_culatta_1.glb
 Azione1=avvita(0.005)
 DrivenObjects=flangia.glb,traslazione:(0,0,0.005,0.5);tubograsso.glb,traslazione:(0,0,0.005,0.5)  # Both move according to tightening
[Next Step - Tighten extractor screws 2]
HighlightDescription=false
 Descrizione=Tighten head screw 2 with the Allen key
 Utensile=ChiaveBrugola
 Elemento=models/vite_culatta_2.glb
 Azione1=avvita(0.005)
 DrivenObjects=flangia.glb,traslazione:(0,0,0.005,0.5);tubograsso.glb,traslazione:(0,0,0.005,0.5)  # Both move according to tightening
