# Tutorial for Vacuum Pump Maintenance
# This file defines the guided sequence for filter replacement
# and greasing of the Becker U5.40 vacuum pump
# Each section represents a step with specific actions and animations

CameraPos=(-1.5, 0.5,-0.2)                                       // Absolute position for testing
CameraTarget=(0, 0, 0)                                    // Focus on scene center slightly raised
CameraZoom=1.2                                                // Slight zoom for overview
CameraTransitionTime=2.5                                      // Smooth movement with gentle easing
Posizione=planaxis:(-0.5,0.01,-0.5)                           // Position specific model

[Filter Cleaning and Greasing]                                            // Main tutorial - disassembly sequence
  Azione1=resetCenteredOriginal
  [Step 1 - First Screw]
  HighlightDescription=true                                 // First step: removal of first screw
  Elemento=models/vite_coperchio_1.glb                         // 3D model of the first screw to animate
  Utensile=Mani                                            // Required tool: manual work
  Descrizione=Select the "Hand" tool and remove the first lid screw          // Text shown in the side speech bubble
  Azione1=svita
  Azione2=appoggia(0.2)


  [Next Step - Second Screw]                                  // Second step: upper right corner screw
  HighlightDescription=false                                 // Highlight the description for the second step
  Elemento=models/vite_coperchio_2.glb                            // Model of the second screw
  Utensile=Mani                                            // Tool: always manual for screws
  Descrizione=Remove the second lid screw        // Description for the user
  Azione1=svita
  Azione2=appoggia(0.2)
Autoaction=true
  [Next Step - Third Screw]                                    // Third step: lower left corner screw
  HighlightDescription=false
  Elemento=models/vite_coperchio_3.glb                            // Model of the third screw
  Utensile=Mani                                            // Tool: manual operation
  Descrizione=Remove the third lid screw          // Instruction for the operator
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step - Fourth Screw]                                   // Fourth step: last screw lower right corner
  HighlightDescription=false
  Elemento=models/vite_coperchio_4.glb                            // Model of the last lid screw
  Utensile=Mani                                            // Tool: manual operation
  Descrizione=Remove the fourth lid screw         // Final instruction for the screws
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step- Lid]                                     // Fifth step: complete lid removal
  HighlightDescription=true
  Elemento=models/coperchio.glb                                   // Model of the pump lid
  Utensile=Mani                                            // Tool: manual lifting
  Descrizione=Remove the filter lid              // Instruction for lid removal
  Azione1=traslazione:(-0.5,0,0.5,0.8)
  Azione2=centro:(0,0.1,0);rotazione:(0,0,-90,0.8)                       // Lid extraction 0.4 units in 1.5 seconds
  Azione3=appoggia(0.5)



[Next Step - Filter]                                        // Sixth step: worn filter extraction
HighlightDescription=true
Elemento=models/filtro.glb                                     // 3D model of the filter to replace
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Remove the filter                           // Instruction for filter removal
  Azione1=traslazione:(-0.3,0,0,1.5)
  Azione2=traslazione:(0,0,0.5,1.5)
  Azione3=appoggia(1.5)
  //Action=extract                                           // Animation: linear extraction without rotation
  //Distance=0.4                                            // Extraction distance (compact filter)
  //Duration=1.5                                              // Custom duration: quick extraction

 [Next Step - Compressed Air]
 HighlightDescription=true
 Elemento=models/filtro.glb
  Descrizione=Clean the filter with compressed air
  CameraPos=(-0.2,0.33,0.74)                                      // Absolute position for testing
  CameraTarget=filtro                                  // Focus on scene center slightly raised
  CameraZoom=0.5                                               // Slight zoom for overview
  Utensile=Aria
  Azione1=traslazione:(0,0.01,0,0.5)
  Azione2=appoggia(0.5)

[Next Step- Right Cap]                                        // Sixth step: worn filter extraction
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Absolute position for testing
  CameraTarget=tappino_grasso_dx                                    // Focus on scene center slightly raised
  CameraZoom=0.5                                           // Close-up zoom for cap interaction
  CameraTransitionTime=2.5                                      // Smooth movement with gentle easing

  Elemento=models/tappino_grasso_dx.glb                                     // 3D model of the filter to replace
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Remove the right greaser protective cap       // Instruction for filter removal
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Cap extraction 0.3 units
  Azione2=appoggia(0.5)


[Next Step - Left Cap]                                        // Sixth step: worn filter extraction
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Absolute position for testing
  CameraTarget=tappino_grasso_sx                                    // Focus on scene center slightly raised
  CameraZoom=0.5                                           // Close-up zoom for cap interaction
  CameraTransitionTime=2.5                                      // Smooth movement with gentle easing
  Elemento=models/tappino_grasso_sx.glb                                     // 3D model of the filter to replace
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Remove the left greaser protective cap       // Instruction for filter removal
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Cap extraction 0.3 units
  Azione2=appoggia(0.5)


[Next Step - Greaser]                                        // Ninth step: greaser movement
HighlightDescription=false
Elemento=models/ingrassatore.glb                                     // 3D model of the greaser to animate
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Pick up the grease pump        // Instruction for movement
  Azione1=traslazione:(0,0.1,0,0.8)
  Azione2=centro:(-0.1,0,0);rotazione:(0,0,90,0.8)
  Azione3=traslazione:(-0.2,0.0,0,0.8)
  Azione4=appoggia(0.5)
  //CameraPos=greaser:(-1, 0, 0)                    // Position relative to the greaser
  //CameraTarget=greaser                               // Direct focus on the greaser
  //CameraZoom=2.2                                          // High zoom for precision operation
  //CameraTransitionTime=1.2                                // Transition with gentle easing

[Next Step - Greaser2]                                        // Tenth step: greaser movement
HighlightDescription=true
CameraPos=(-0.42, 0.33,  0.3 )
  CameraTarget=(-0.28, 0.25,-0.16)                                       // Absolute position for testing


  Elemento=models/ingrassatore.glb                                     // 3D model of the greaser to animate
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Apply grease to the right greaser by pumping 10 times     // Instruction for movement
  Azione1=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)
  Azione2=oscillazione:tappino_grasso_dx_original,(-0.08,0,0,-0.09,0,0,10,0.1)
  Azione3=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)

[Next Step - Greaser3]                                        // Tenth step: greaser movement
HighlightDescription=false

  Elemento=models/ingrassatore.glb                                     // 3D model of the greaser to animate
  Utensile=Mani                                           // Tool: manual extraction
  Descrizione=Apply grease to the left greaser by pumping 10 times     // Instruction for movement
  Azione1=traslazione:tappino_grasso_sx_original,(-0.2,0.0,0,0.5)
  Azione2=oscillazione:tappino_grasso_sx_original,(-0.08,0,0,-0.09,0,0,10,0.1)
  Azione3=traslazione:tappino_grasso_sx_original,(-0.2,0.0,0,0.5)
  Azione4=traslazione:ingrassatore_original,(-0.2,0.0,0,0.5)
  Azione5=appoggia(0.5)

[Reassembly]
HighlightDescription=true
# Reverse tutorial - reassembly sequence
# Sequence to reassemble the filter and close the pump

# Camera reset at the beginning of the tutorial


# IMPORTANT: Disable auto-completion for multi-step tutorial
//AutoComplete=false
TutorialSteps=5

# Model positioning for assembly - Corrected custom positions
# IMPORTANT: Parts start "disassembled" as at the end of cleaning

# Model 1: lid
Posizione=coperchio:(-1.148,-0.261,0.500)
Rotazione=coperchio:(0.0,0.0,-90.0)

# Model 2: filter
Posizione=filtro:(-0.300,-0.142,0.500)
Rotazione=filtro:(0.0,0.0,0.0)

# Model 3: floor
Posizione=pavimento:(0.000,0.000,0.000)
Rotazione=pavimento:(0.0,0.0,0.0)

# Model 4: lid_screw_1
Posizione=vite_coperchio_1:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_1:(-360.0,0.0,0.0)

# Model 5: lid_screw_2
Posizione=vite_coperchio_2:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_2:(-360.0,0.0,0.0)

# Model 6: lid_screw_3
Posizione=vite_coperchio_3:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_3:(-360.0,0.0,0.0)

# Model 7: lid_screw_4
Posizione=vite_coperchio_4:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_4:(-360.0,0.0,0.0)

# Model 8: left_grease_cap
Posizione=tappino_grasso_sx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_sx:(0.0,0.0,0.0)

# Model 9: right_grease_cap
Posizione=tappino_grasso_dx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_dx:(0.0,0.0,0.0)

# Model 10: greaser
Posizione=ingrassatore:(-0.208,0.243,0)
Rotazione=ingrassatore:(0.0,0.0,90.0)


[Step 1 - Right Cap]
HighlightDescription=true
CameraPos=(-1.03,0.27,0.03)
CameraTarget=(-0.17,0.14,-0.01)
