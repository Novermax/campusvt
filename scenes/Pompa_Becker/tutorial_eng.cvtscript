  Azione23=traslazione:ingrassatore_original,(-0.2,0.0,0,0.5)
  Azione24=appoggia(0.5)

[Reassembly]
HighlightDescription=true
# Reverse tutorial - reassembly sequence
# Sequence to reinstall the filter and close the pump

# Camera configuration
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=(0, 0, 0)
CameraZoom=1.2
CameraTransitionTime=2.5

# IMPORTANT: Disable auto-completion for multi-step tutorial
//AutoComplete=false
TutorialSteps=5

# Model positioning for assembly - Correct custom positions
# IMPORTANT: Parts start "disassembled" as at the end of the cleaning

# Model 1: coperchio
Posizione=coperchio:(-1.148,-0.261,0.500)
Rotazione=coperchio:(0.0,0.0,-90.0)

# Model 2: filtro
Posizione=filtro:(-0.300,-0.142,0.500)
Rotazione=filtro:(0.0,0.0,0.0)

# Model 3: pavimento
Posizione=pavimento:(0.000,0.000,0.000)
Rotazione=pavimento:(0.0,0.0,0.0)

# Model 4: vite_coperchio_1
Posizione=vite_coperchio_1:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_1:(-360.0,0.0,0.0)

# Model 5: vite_coperchio_2
Posizione=vite_coperchio_2:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_2:(-360.0,0.0,0.0)

# Model 6: vite_coperchio_3
Posizione=vite_coperchio_3:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_3:(-360.0,0.0,0.0)

# Model 7: vite_coperchio_4
Posizione=vite_coperchio_4:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_4:(-360.0,0.0,0.0)

# Model 8: tappino_grasso_sx
Posizione=tappino_grasso_sx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_sx:(0.0,0.0,0.0)

# Model 9: tappino_grasso_dx
Posizione=tappino_grasso_dx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_dx:(0.0,0.0,0.0)

# Model 10: ingrassatore
Posizione=ingrassatore:(-0.208,0.243,0)
Rotazione=ingrassatore:(0.0,0.0,90.0)


[Step 1 - Grease fitting caps]
HighlightDescription=true
Descrizione=Install the grease fitting caps in any order. You can start with the right or left one.
Utensile=Mani

# Interchangeable node - free order for caps (NO specific Element)
DragDrop=true
AssemblyMode=true
AllowedComponents=tappino_grasso_dx,tappino_grasso_sx
DragDropDistance=0.2



[Next Step - Filter]
HighlightDescription=true
Descrizione=Insert the filter into its housing.
Utensile=Mani

# Sequential assembly system - filter
DragDrop=true
AssemblyMode=true
# Only the filter can be assembled in this step
AllowedComponents=filtro
DragDropDistance=0.3


[Next Step - Cover]
HighlightDescription=true

Descrizione=Position the cover on top of the filter.
Utensile=Mani

# Continue sequential assembly - cover
DragDrop=true
AssemblyMode=true


AllowedComponents=coperchio
DragDropDistance=0.3



[Next Step - Cover screws group]
HighlightDescription=true

Descrizione=Install the 4 cover screws in any order.
Utensile=Mani

# Interchangeable node - free order for screws
DragDrop=true
AssemblyMode=true



AllowedComponents=vite_coperchio_1,vite_coperchio_2,vite_coperchio_3,vite_coperchio_4


DragDropDistance=0.2

ValidateAssembly=true



[Next Step - Final grease pump]
HighlightDescription=true

Descrizione=Finally, place the grease pump back in its rest position. Requires all screws to be installed.
Utensile=Mani

# Final step - requires all prerequisites
DragDrop=true
AssemblyMode=true


AllowedComponents=ingrassatore
DragDropDistance=0.3





[Vane Replacement Disassembly]
HighlightDescription=true                                 // Tutorial futuro per sostituzione palette pompa
CameraPos=(0, 0.5,1)                                       // Posizione assoluta per test
  CameraTarget=(0, 0, 0)                                    // Focus su centro scena leggermente rialzato
  CameraZoom=1.2                                                // Zoom leggero per visione d''insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
  Azione1=resetCenteredOriginal


[Step 1 - Remove head screw 1]
HighlightDescription=true
Elemento=models/vite_culatta_1.glb
Descrizione=Remove the first Allen head screw from the cylinder head using the 6mm Allen key.
Utensile=ChiaveBrugola
Azione1=svita(0.3)
Azione2=appoggia(0.2)

[Next Step - Remove head screw 2]
HighlightDescription=false
Elemento=models/vite_culatta_2.glb
Descrizione=Remove the second Allen head screw from the cylinder head using the 6mm Allen key.
Utensile=ChiaveBrugola
Azione1=svita(0.3)
Azione2=appoggia(0.2)
Autoaction=true

[Next Step - Remove head screw 3]
HighlightDescription=false
Elemento=models/vite_culatta_3.glb
Descrizione=Remove the third Allen head screw from the cylinder head using the 6mm Allen key. Note that the lower screws are shorter.
Utensile=ChiaveBrugola
Azione1=svita(0.3)
Azione2=traslazione:( -0.1,0,0,0.2)
Azione3=appoggia(0.2)
Autoaction=true
[Next Step - Remove head screw 4]
HighlightDescription=false
Elemento=models/vite_culatta_4.glb
Descrizione=Remove the fourth Allen head screw from the cylinder head using the 6mm Allen key. Note that the lower screws are shorter.
Utensile=ChiaveBrugola
Azione1=svita(0.3)
Azione2=traslazione:( -0.1,0,0,0.2)
Azione3=appoggia(0.2)
Autoaction=true
[Next Step - Remove the head]
HighlightDescription=false
Elemento=models/culatta.glb
Descrizione=Remove the pump cylinder head using the "Hand" tool.
Utensile=Mani
Azione1=traslazione:( 0.5,0,0.5,0.5)
Azione2=rotazione:(-90,0,0,0.8)
Azione3=appoggia(0.2)

