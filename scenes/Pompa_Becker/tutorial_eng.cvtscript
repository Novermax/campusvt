Azione1=svita(0.1)
Azione2=appoggia(0.2)
[Next Step - Remove vite_culatta_1]
HighlightDescription=false
Elemento=models/vite_culatta_1.glb
Descrizione=Remove the screw used as extractor with the 6mm Allen key.
Utensile=ChiaveBrugola
Azione1=svita(0.1)
Azione2=appoggia(0.2)

[Next Step - Flange translation]
