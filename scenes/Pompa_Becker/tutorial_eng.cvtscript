# Vane Replacement Tutorial - Reassembly (Reverse)
# Reverse sequence compared to disassembly
# Uses DragDrop + AssemblyMode for positioning
# Manual screw tightening one by one

TutorialSteps=30

[Step 1 - Reassemble vane 1]
HighlightDescription=true
Descrizione=Pick up vane 1 and reassemble it in its original seat. The vane will be rotated and positioned automatically.
Utensile=Mani
Elemento=models/paletta1.glb
Rotazione=paletta1:(0.0,0.0,0.0)
Azione1=traslazione:(0.625,0.156,-0.300,1.2)
Azione2=traslazione:(0,0,-0.4,1.2)

