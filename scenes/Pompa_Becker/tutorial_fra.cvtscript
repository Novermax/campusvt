# Tutoriel pour la Maintenance de la Pompe à Vide
# Ce fichier définit la séquence guidée pour le remplacement du filtre
# et le graissage de la pompe à vide Pompa Becker U5.40
# Chaque section représente une étape avec des actions spécifiques et des animations

CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
CameraTarget=(0, 0, 0)                                    // Focus sur le centre de la scène légèrement surélevé
CameraZoom=1.2                                                // Zoom léger pour vue d'ensemble
CameraTransitionTime=2.5                                      // Mouvement fluide avec easing doux
Posizione=planaxis:(-0.5,0.01,-0.5)                           // Positionne le modèle spécifique

[Nettoyage Filtre et graissage]                                            // Tutoriel principal - séquence de démontage
  Azione1=resetCenteredOriginal
  [Step 1 - Première vis]
  HighlightDescription=true                                 // Première étape : retrait de la première vis
  Elemento=models/vite_coperchio_1.glb                         // Modèle 3D de la première vis à animer
  Utensile=Mani                                            // Outil requis : travail manuel
  Descrizione=Sélectionnez l'outil "Main" et retirez la première vis du couvercle          // Texte affiché dans la bulle latérale
  Azione1=svita
  Azione2=appoggia(0.2)


  [Next Step - Deuxième vis]                                  // Deuxième étape : vis coin supérieur droit
  HighlightDescription=false                                 // Met en évidence la description pour la deuxième étape
  Elemento=models/vite_coperchio_2.glb                            // Modèle de la deuxième vis
  Utensile=Mani                                            // Outil : toujours manuel pour les vis
  Descrizione=Retirez la deuxième vis du couvercle        // Description pour l'utilisateur
  Azione1=svita
  Azione2=appoggia(0.2)
Autoaction=true
  [Next Step - Troisième vis]                                    // Troisième étape : vis coin inférieur gauche
  HighlightDescription=false
  Elemento=models/vite_coperchio_3.glb                            // Modèle de la troisième vis
  Utensile=Mani                                            // Outil : opération manuelle
  Descrizione=Retirez la troisième vis du couvercle          // Instruction pour l'opérateur
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step - Quatrième vis]                                   // Quatrième étape : dernière vis coin inférieur droit
  HighlightDescription=false
  Elemento=models/vite_coperchio_4.glb                            // Modèle de la dernière vis du couvercle
  Utensile=Mani                                            // Outil : opération manuelle
  Descrizione=Retirez la quatrième vis du couvercle         // Instruction finale pour les vis
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step- Couvercle]                                     // Cinquième étape : retrait du couvercle complet
  HighlightDescription=true
  Elemento=models/coperchio.glb                                   // Modèle du couvercle de la pompe
  Utensile=Mani                                            // Outil : soulèvement manuel
  Descrizione=Retirez le couvercle du filtre              // Instruction pour le retrait du couvercle
  Azione1=traslazione:(-0.5,0,0.5,0.8)
  Azione2=centro:(0,0.1,0);rotazione:(0,0,-90,0.8)                       // Extraction du couvercle 0.4 unités en 1.5 secondes
  Azione3=appoggia(0.5)



[Next Step - Filtre]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
Elemento=models/filtro.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le filtre                           // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.5)
  Azione2=traslazione:(0,0,0.5,1.5)
  Azione3=appoggia(1.5)
  //Action=extraction                                           // Animation : extraction linéaire sans rotation
  //Distance=0.4                                            // Distance d'extraction (filtre compact)
  //Durée=1.5                                              // Durée personnalisée : extraction rapide

 [Next Step - Air comprimé]
 HighlightDescription=true
 Elemento=models/filtro.glb
  Descrizione=Nettoyez le filtre avec l'air comprimé
  CameraPos=(-0.2,0.33,0.74)                                      // Position absolue pour test
  CameraTarget=filtro                                  // Focus sur le centre de la scène légèrement surélevé
  CameraZoom=0.5                                               // Zoom léger pour vue d'ensemble
  Utensile=Aria
  Azione1=traslazione:(0,0.01,0,0.5)
  Azione2=appoggia(0.5)

[Next Step- Bouchon droit]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
  CameraTarget=tappino_grasso_dx                                    // Focus sur le centre de la scène légèrement surélevé
  CameraZoom=0.5                                           // Zoom rapproché pour interaction bouchons
  CameraTransitionTime=2.5                                      // Mouvement fluide avec easing doux

  Elemento=models/tappino_grasso_dx.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le capuchon de protection du graisseur de droite       // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Extraction bouchon 0.3 unités
  Azione2=appoggia(0.5)


[Next Step - Bouchon gauche]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
  CameraTarget=tappino_grasso_sx                                    // Focus sur le centre de la scène légèrement surélevé
  CameraZoom=0.5                                           // Zoom rapproché pour interaction bouchons
  CameraTransitionTime=2.5                                      // Mouvement fluide avec easing doux
  Elemento=models/tappino_grasso_sx.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le capuchon de protection du graisseur de gauche       // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Extraction bouchon 0.3 unités
  Azione2=appoggia(0.5)


[Next Step - Graisseur]                                        // Neuvième étape : mouvement du graisseur
HighlightDescription=false
Elemento=models/ingrassatore.glb                                     // Modèle 3D du graisseur à animer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Prenez la pompe à graisse        // Instruction pour le mouvement
  Azione1=traslazione:(0,0.1,0,0.8)
  Azione2=centro:(-0.1,0,0);rotazione:(0,0,90,0.8)
  Azione3=traslazione:(-0.2,0.0,0,0.8)
  Azione4=appoggia(0.5)
  //CameraPos=ingrassatore:(-1, 0, 0)                    // Position relative au graisseur
  //CameraTarget=ingrassatore                               // Focus direct sur le graisseur
  //CameraZoom=2.2                                          // Zoom élevé pour opération de précision
  //CameraTransitionTime=1.2                                // Transition avec easing doux

[Next Step - Graisseur2]                                        // Dixième étape : mouvement du graisseur
HighlightDescription=true
CameraPos=(-0.42, 0.33,  0.3 )
  CameraTarget=(-0.28, 0.25,-0.16)                                       // Position absolue pour test


  Elemento=models/ingrassatore.glb                                     // Modèle 3D du graisseur à animer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Appliquez la graisse dans le graisseur de droite en pompant 10 fois     // Instruction pour le mouvement
  Azione1=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)
  Azione2=oscillazione:tappino_grasso_dx_original,(-0.08,0,0,-0.09,0,0,10,0.1)
  Azione3=traslazione:tappino_grasso_dx_original,(-0.2,0.0,0,0.5)

[Next Step - Graisseur3]                                        // Dixième étape : mouvement du graisseur
HighlightDescription=false

  Elemento=models/ingrassatore.glb                                     // Modèle 3D du graisseur à animer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Appliquez la graisse dans le graisseur de gauche en pompant 10 fois     // Instruction pour le mouvement
  Azione1=traslazione:tappino_grasso_sx_original,(-0.2,0.0,0,0.5)
  Azione2=oscillazione:tappino_grasso_sx_original,(-0.08,0,0,-0.09,0,0,10,0.1)
  Azione3=traslazione:tappino_grasso_sx_original,(-0.2,0.0,0,0.5)
  Azione4=traslazione:ingrassatore_original,(-0.2,0.0,0,0.5)
  Azione5=appoggia(0.5)

[Réassemblage]
HighlightDescription=true
# Tutoriel inverse - séquence de remontage
# Séquence pour remonter le filtre et refermer la pompe

# Réinitialisation caméra au début du tutoriel


# IMPORTANT : Désactiver l'auto-complétion pour tutoriel multi-étapes
//AutoComplete=false
TutorialSteps=5

# Positionnement des modèles pour assemblage - Positions custom corrigées
# IMPORTANT : Les pièces partent "démontées" comme à la fin du nettoyage

# Modèle 1 : couvercle
Posizione=coperchio:(-1.148,-0.261,0.500)
Rotazione=coperchio:(0.0,0.0,-90.0)

# Modèle 2 : filtre
Posizione=filtro:(-0.300,-0.142,0.500)
Rotazione=filtro:(0.0,0.0,0.0)

# Modèle 3 : sol
Posizione=pavimento:(0.000,0.000,0.000)
Rotazione=pavimento:(0.0,0.0,0.0)

# Modèle 4 : vite_coperchio_1
Posizione=vite_coperchio_1:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_1:(-360.0,0.0,0.0)

# Modèle 5 : vite_coperchio_2
Posizione=vite_coperchio_2:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_2:(-360.0,0.0,0.0)

# Modèle 6 : vite_coperchio_3
Posizione=vite_coperchio_3:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_3:(-360.0,0.0,0.0)

# Modèle 7 : vite_coperchio_4
Posizione=vite_coperchio_4:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_4:(-360.0,0.0,0.0)

# Modèle 8 : tappino_grasso_sx
Posizione=tappino_grasso_sx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_sx:(0.0,0.0,0.0)

# Modèle 9 : tappino_grasso_dx
Posizione=tappino_grasso_dx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_dx:(0.0,0.0,0.0)

# Modèle 10 : graisseur
Posizione=ingrassatore:(-0.208,0.243,0)
Rotazione=ingrassatore:(0.0,0.0,90.0)


