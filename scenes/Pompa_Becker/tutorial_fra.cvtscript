 Azione20=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)

  Azione21=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)


  //Azione22=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
