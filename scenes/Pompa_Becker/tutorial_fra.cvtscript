[Remontage]
HighlightDescription=true
# Tutoriel inversé - séquence de remontage
# Séquence pour réinstaller le filtre et fermer la pompe

# Configuration caméra
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=(0, 0, 0)
CameraZoom=1.2
CameraTransitionTime=2.5

# IMPORTANT : Désactiver la complétion automatique pour le tutoriel multi-étapes
//AutoComplete=false
TutorialSteps=5

# Positionnement des modèles pour le montage - Positions personnalisées correctes
# IMPORTANT : Les pièces commencent "démontées" comme à la fin du nettoyage

# Modèle 1 : coperchio
Posizione=coperchio:(-1.148,-0.261,0.500)
Rotazione=coperchio:(0.0,0.0,-90.0)

# Modèle 2 : filtro
Posizione=filtro:(-0.300,-0.142,0.500)
Rotazione=filtro:(0.0,0.0,0.0)

# Modèle 3 : pavimento
Posizione=pavimento:(0.000,0.000,0.000)
Rotazione=pavimento:(0.0,0.0,0.0)

# Modèle 4 : vite_coperchio_1
Posizione=vite_coperchio_1:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_1:(-360.0,0.0,0.0)

# Modèle 5 : vite_coperchio_2
Posizione=vite_coperchio_2:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_2:(-360.0,0.0,0.0)

# Modèle 6 : vite_coperchio_3
Posizione=vite_coperchio_3:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_3:(-360.0,0.0,0.0)

# Modèle 7 : vite_coperchio_4
Posizione=vite_coperchio_4:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_4:(-360.0,0.0,0.0)

# Modèle 8 : tappino_grasso_sx
Posizione=tappino_grasso_sx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_sx:(0.0,0.0,0.0)

# Modèle 9 : tappino_grasso_dx
Posizione=tappino_grasso_dx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_dx:(0.0,0.0,0.0)

# Modèle 10 : ingrassatore
Posizione=ingrassatore:(-0.208,0.243,0)
Rotazione=ingrassatore:(0.0,0.0,90.0)


[Step 1 - Bouchons de raccord de graissage]
HighlightDescription=true
Descrizione=Installez les bouchons de raccord de graissage dans n'importe quel ordre. Vous pouvez commencer par le droit ou le gauche.
Utensile=Mani

# Nœud interchangeable - ordre libre pour les bouchons (SANS Élément spécifique)
DragDrop=true
AssemblyMode=true
AllowedComponents=tappino_grasso_dx,tappino_grasso_sx
DragDropDistance=0.2



[Next Step - Filtre]
HighlightDescription=true
Descrizione=Insérez le filtre dans son logement.
Utensile=Mani

# Système d'assemblage séquentiel - filtre
DragDrop=true
AssemblyMode=true
# Seul le filtre peut être assemblé dans cette étape
AllowedComponents=filtro
DragDropDistance=0.3


[Next Step - Couvercle]
HighlightDescription=true

Descrizione=Positionnez le couvercle sur le dessus du filtre.
Utensile=Mani

# Continuation de l'assemblage séquentiel - couvercle
DragDrop=true
AssemblyMode=true


AllowedComponents=coperchio
DragDropDistance=0.3



[Next Step - Groupe de vis du couvercle]
HighlightDescription=true

Descrizione=Installez les 4 vis du couvercle dans n'importe quel ordre.
Utensile=Mani

# Nœud interchangeable - ordre libre pour les vis
DragDrop=true
AssemblyMode=true



AllowedComponents=vite_coperchio_1,vite_coperchio_2,vite_coperchio_3,vite_coperchio_4


DragDropDistance=0.2

ValidateAssembly=true



[Next Step - Pompe à graisse finale]
HighlightDescription=true

Descrizione=Enfin, replacez la pompe à graisse dans sa position de repos. Nécessite que toutes les vis soient installées.
Utensile=Mani

# Étape finale - nécessite tous les prérequis
DragDrop=true
AssemblyMode=true


AllowedComponents=ingrassatore
DragDropDistance=0.3




[Démontage Remplacement Palettes]
HighlightDescription=true                                 // Tutoriel futur pour le remplacement des palettes de la pompe
CameraPos=(0, 0.5,1)                                       // Position absolue pour test
