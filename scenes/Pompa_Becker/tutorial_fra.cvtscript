# Tutorial per Manutenzione Pompa del Vuoto
# Sequenza guidata per la sostituzione del filtro e l'ingrassaggio della pompa del vuoto Pompa Becker U5.40
# Sintassi: CVTScript v3

[scene]
camera   = position (-1.5, 0.5, -0.2), target (0, 0, 0), zoom 1.2, fade 2.5
position = planaxis at (-0.5, 0.01, -0.5)


# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TUTORIAL 1: Pulizia Filtro e ingrassaggio
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Nettoyage du filtre et lubrification"]
do : idle reset

[step "Première vis" highlight]
element     = vite_coperchio_1
tool        = hand
description = Sélectionnez l'outil "Main" et retirez la première vis du couvercle
do          : unscrew
do          : place duration 0.2

[step "Deuxième vis" auto]
element     = vite_coperchio_2
tool        = hand
description = Retirez la deuxième vis du couvercle
do          : unscrew
do          : place duration 0.2

[step "Troisième vis" auto]
element     = vite_coperchio_3
tool        = hand
description = Retirez la troisième vis du couvercle
do          : unscrew
do          : move by (0, 0, -0.1) duration 0.2
do          : place duration 0.2

[step "Quatrième vis" auto]
element     = vite_coperchio_4
tool        = hand
description = Retirez la quatrième vis du couvercle
do          : unscrew
do          : move by (0, 0, -0.1) duration 0.2
do          : place duration 0.2

[step "Couvercle" highlight]
element     = coperchio
tool        = hand
description = Retirez le couvercle du filtre
do          : move by (-0.5, 0, 0.5) duration 0.8
do          : rotate around (0, 0.1, 0) by (0, 0, -90) duration 0.8
do          : place duration 0.5

[step "Filtre" highlight]
element     = filtro
tool        = hand
description = Retirez le filtre
do          : move by (-0.3, 0, 0) duration 1.5
do          : move by (0, 0, 0.5) duration 1.5
do          : place duration 1.5

[step "Air comprimé" highlight]
element     = filtro
description = Nettoyez le filtre avec l'air comprimé
camera      = position (-0.2, 0.33, 0.74), target filtro, zoom 0.5
tool        = air
do          : move by (0, 0.01, 0) duration 0.5
do          : place duration 0.5

[step "Bouchon droit" highlight]
camera      = position (-1.5, 0.5, -0.2), target tappino_grasso_dx, zoom 0.5, fade 2.5
element     = tappino_grasso_dx
tool        = hand
description = Retirez le capuchon de protection du graisseur droit
do          : move by (-0.3, 0, 0) duration 1.0
do          : place duration 0.5

[step "Bouchon gauche" highlight]
camera      = position (-1.5, 0.5, -0.2), target tappino_grasso_sx, zoom 0.5, fade 2.5
element     = tappino_grasso_sx
tool        = hand
description = Retirez le capuchon de protection du graisseur gauche
do          : move by (-0.3, 0, 0) duration 1.0
do          : place duration 0.5

[step "Graisseur"]
element     = ingrassatore
tool        = hand
description = Prenez la pompe à graisse
do          : move by (0, 0.1, 0) duration 0.8
do          : rotate around (-0.1, 0, 0) by (0, 0, 90) duration 0.8
do          : move by (-0.2, 0, 0) duration 0.8
do          : place duration 0.5

[step "Graisseur droit" highlight]
camera      = position (-0.42, 0.33, 0.3), target (-0.28, 0.25, -0.16)
element     = ingrassatore
tool        = hand
description = Appliquez de la graisse dans le graisseur droit en pompant 10 fois
do          : move from tappino_grasso_dx_original by (-0.2, 0, 0) duration 0.5
do          : pump from tappino_grasso_dx_original between (-0.08, 0, 0) and (-0.09, 0, 0) cycles 10 duration 0.1
do          : move from tappino_grasso_dx_original by (-0.2, 0, 0) duration 0.5

[step "Graisseur gauche"]
element     = ingrassatore
tool        = hand
description = Appliquez de la graisse dans le graisseur gauche en pompant 10 fois
do          : move from tappino_grasso_sx_original by (-0.2, 0, 0) duration 0.5
do          : pump from tappino_grasso_sx_original between (-0.08, 0, 0) and (-0.09, 0, 0) cycles 10 duration 0.1
do          : move from tappino_grasso_sx_original by (-0.2, 0, 0) duration 0.5
do          : move from ingrassatore_original by (-0.2, 0, 0) duration 0.5
do          : place duration 0.5


# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TUTORIAL 2: Riassemblaggio
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Remontage"]
# Tutorial inverso - sequenza di rimontaggio
camera   = position (-1.5, 0.5, -0.2), target (0, 0, 0), zoom 1.2, fade 2.5

# Posizionamento modelli per assemblaggio - pezzi partono smontati
position = coperchio at (-1.148, -0.261, 0.500)
rotation = coperchio by (0.0, 0.0, -90.0)
position = filtro at (-0.300, -0.142, 0.500)
rotation = filtro by (0.0, 0.0, 0.0)
position = pavimento at (0.000, 0.000, 0.000)
rotation = pavimento by (0.0, 0.0, 0.0)
position = vite_coperchio_1 at (-0.500, -0.349, 0.000)
rotation = vite_coperchio_1 by (-360.0, 0.0, 0.0)
position = vite_coperchio_2 at (-0.500, -0.349, 0.000)
rotation = vite_coperchio_2 by (-360.0, 0.0, 0.0)
position = vite_coperchio_3 at (-0.500, -0.117, -0.100)
rotation = vite_coperchio_3 by (-360.0, 0.0, 0.0)
position = vite_coperchio_4 at (-0.500, -0.117, -0.100)
rotation = vite_coperchio_4 by (-360.0, 0.0, 0.0)
position = tappino_grasso_sx at (-0.300, -0.243, 0.000)
rotation = tappino_grasso_sx by (0.0, 0.0, 0.0)
position = tappino_grasso_dx at (-0.300, -0.243, 0.000)
rotation = tappino_grasso_dx by (0.0, 0.0, 0.0)
position = ingrassatore at (-0.208, 0.243, 0)
rotation = ingrassatore by (0.0, 0.0, 90.0)

[step "Bouchon droit" highlight]
camera      = position (-1.03, 0.27, 0.03), target (-0.17, 0.14, -0.01), rotation (-1.3, -1.41, -1.3), pivot (-0.17, 0.14, -0.01), distance 0.86, fov 75, fade 1.0
description = Montez le bouchon du graisseur droit.
tool        = hand
drag        = tappino_grasso_dx distance 0.2

[step "Bouchon gauche" highlight]
camera      = target tappino_grasso_sx
description = Montez le bouchon du graisseur gauche.
tool        = hand
drag        = tappino_grasso_sx distance 0.2

[step "Filtre" highlight]
camera      = position (-1.38, 0.5, 0.27), target (-0.58, 0.01, -0.16), rotation (-0.86, -0.88, -0.73), pivot (-0.58, 0.01, -0.16), distance 1.03, fov 75, fade 1.0
description = Insérez le filtre dans son logement.
tool        = hand
drag        = filtro distance 0.3

[step "Couvercle" highlight]
description = Positionnez le couvercle sur le filtre.
tool        = hand
drag        = coperchio distance 0.3

[step "Groupe de vis du couvercle" highlight]
camera      = position (-1.14, 0.27, -0.04), target (-0.32, 0, -0.01), rotation (-1.67, -1.25, -1.67), pivot (-0.32, 0, -0.01), distance 0.86, fov 75, fade 1.0
description = Montez les 4 vis du couvercle dans n'importe quel ordre.
tool        = hand
drag        = vite_coperchio_1, vite_coperchio_2, vite_coperchio_3, vite_coperchio_4 distance 0.2

[step "Graisseur final" highlight]
description = Enfin, rangez le graisseur dans la position de repos. Nécessite que toutes les vis soient montées.
tool        = hand
drag        = ingrassatore distance 0.3


# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TUTORIAL 3: Sostituzione Palette Smontaggio
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Remplacement des palettes - Démontage"]
camera = position (-0.08, 0.34, 0.8), target (-0.03, 0.24, 0.27), rotation (-0.2, -0.09, -0.02), pivot (-0.03, 0.24, 0.27), distance 0.54, fov 75, fade 1.0
do     : idle reset

[step "Retirer la vis 1 de la culasse" highlight]
element     = vite_culatta_1
description = Retirez la première vis à six pans creux de la culasse avec la clé Allen de 6mm.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Retirer la vis 2 de la culasse" auto]
element     = vite_culatta_2
description = Retirez la deuxième vis à six pans creux de la culasse avec la clé Allen de 6mm.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Retirer la vis 3 de la culasse" auto]
element     = vite_culatta_3
description = Retirez la troisième vis à six pans creux de la culasse avec la clé Allen de 6mm. Notez que les vis inférieures sont plus courtes.
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Retirer la vis 4 de la culasse" auto]
element     = vite_culatta_4
description = Retirez la quatrième vis à six pans creux de la culasse avec la clé Allen de 6mm. Notez que les vis inférieures sont plus courtes.
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Retirer la culasse"]
element     = culatta
description = Retirez la culasse de la pompe avec l'outil "Main".
tool        = hand
do          : move by (0.5, 0, 0.5) duration 0.5
do          : rotate by (-90, 0, 0) duration 0.8
do          : place duration 0.2

[step "Retirer la vis 1 de la bride" highlight]
element     = vite_flangia_1
description = Retirez la première vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Retirer la vis 2 de la bride" auto]
element     = vite_flangia_2
description = Retirez la deuxième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Retirer la vis 3 de la bride" auto]
element     = vite_flangia_3
description = Retirez la troisième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Retirer la vis 4 de la bride" auto]
element     = vite_flangia_4
description = Retirez la quatrième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Retirer la vis 5 de la bride" auto]
element     = vite_flangia_5
description = Retirez la cinquième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Retirer la vis 6 de la bride" auto]
element     = vite_flangia_6
description = Retirez la sixième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Retirer la vis 7 de la bride" auto]
element     = vite_flangia_7
description = Retirez la septième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Retirer la vis 8 de la bride" auto]
element     = vite_flangia_8
description = Retirez la huitième vis à tête hexagonale avec la clé plate de 10mm.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Instructions de démontage de la bride" highlight]
message     = Prenez deux vis de 8mm et insérez-les dans les emplacements appropriés pour les utiliser comme extracteur.
title       = Important
video       = media/estrattore.mp4
description = Phase d'extraction de la bride avec les vis extracteurs
camera      = position (0, 0.45, 0.89), zoom 1
tool        = hand
drag        = vite_culatta_1, vite_culatta_2 distance 0 snap targets estrattoresx_original, estrattoredx_original

[step "Serrer les vis de l'extracteur" highlight]
camera      = position (0.01,0.44,0.54), target (-0.03,0.24,0.27), rotation (-0.64,0.13,0.1), pivot (-0.03,0.24,0.27), distance 0.11, fov 75, fade 1.0
description = Serrez la vis de culasse 1 avec la clé Allen.
tool        = hex_key
element     = vite_culatta_1
do          : screw distance 0.005
companion   = flangia moves by (0, 0, 0.005) duration 0.5
companion   = tubograsso moves by (0, 0, 0.005) duration 0.5

[step "Serrer les vis de l'extracteur 2"]
description = Serrez la vis de culasse 2 avec la clé Allen.
tool        = hex_key
element     = vite_culatta_2
do          : screw distance 0.005
companion   = flangia moves by (0, 0, 0.005) duration 0.5
companion   = tubograsso moves by (0, 0, 0.005) duration 0.5

[step "Retirer la vis extracteur 2"]
element     = vite_culatta_2
description = Retirez la vis utilisée comme extracteur avec la clé Allen de 6mm.
tool        = hex_key
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Retirer la vis extracteur 1"]
element     = vite_culatta_1
description = Retirez la vis utilisée comme extracteur avec la clé Allen de 6mm.
tool        = hex_key
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Translation de la bride" highlight]
camera      = zoom 1
element     = flangia
description = Éloignez la bride avec les mains. Le tube de graisse se déplace avec elle.
tool        = hand
companion   = tubograsso follows master
do          : move by (0, 0, 0.2) duration 0.5

[step "Détacher le tube de graisse" highlight]
element     = tubograsso
description = Détachez le tube de graisse de la bride.
tool        = hand
do          : move by (0, 0, -0.2) duration 0.5

[step "Extraire la bride" highlight]
element     = flangia
description = Posez la bride au sol.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (90, 0, 0) duration 0.5
do          : place duration 0.2

[step "Extraire la palette 1" highlight]
camera      = position (0.14, 0.96, 1.21), target (-0.03, 0.24, 0.27), rotation (-0.65, 0.14, 0.11), pivot (-0.03, 0.24, 0.27), distance 1.2, fov 75, fade 1.0
element     = paletta1
description = Posez la palette 1 au sol.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -32) duration 0.5
do          : move by (-0.5, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Extraire la palette 2" auto]
element     = paletta2
description = Posez la palette 2 au sol.
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -108) duration 0.5
do          : move by (-0.7, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Extraire la palette 3" auto]
element     = paletta3
description = Posez la palette 3 au sol.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, 0) duration 0.5
do          : move by (-0.9, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Extraire la palette 4" auto]
element     = paletta4
description = Posez la palette 4 au sol.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -72) duration 0.5
do          : move by (-1.1, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Extraire la palette 5" auto]
element     = paletta5
description = Posez la palette 5 au sol.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, 32) duration 0.5
do          : move by (-1.3, 0, 0.2) duration 0.5
do          : place duration 0.2


