  Azione11=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
  Azione12=traslazione:tappino_grasso_dx_original,(-0.08,0.0,0,0.1)
  Azione13=traslazione:tappino_grasso_dx_original,(-0.09,0.0,0,0.1)
