
# Tutoriel de Maintenance de la Pompe à Vide
# Ce fichier définit la séquence guidée pour le remplacement du filtre
# et la lubrification de la pompe à vide Becker U5.40
# Chaque section représente une étape avec des actions et animations spécifiques

CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
CameraTarget=(0, 0, 0)                                    // Focus sur le centre de scène légèrement surélevé
CameraZoom=1.2                                                // Zoom léger pour une vue d'ensemble
CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce
Posizione=planaxis:(-0.5,0.01,-0.5)                           // Positionne un modèle spécifique

[Nettoyage du filtre et lubrification]                                            // Tutoriel principal - séquence de démontage
  CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
  CameraTarget=(0, 0, 0)                                    // Focus sur le centre de scène légèrement surélevé
  CameraZoom=1.2                                                // Zoom léger pour une vue d'ensemble
  CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce
  Azione1=resetCenteredOriginal
  [Step 1 - Première vis]
  HighlightDescription=true                                 // Première étape : retrait de la première vis
  Elemento=models/vite_coperchio_1.glb                         // Modèle 3D de la première vis à animer
  Utensile=Mani                                            // Outil requis : travail manuel
  Descrizione=Sélectionnez l'outil "Main" et retirez la première vis du couvercle          // Texte affiché dans la bulle latérale
  Azione1=svita
  Azione2=appoggia(0.2)


  [Next Step - Deuxième vis]                                  // Deuxième étape : vis angle supérieur droit
  HighlightDescription=false                                 // Met en évidence la description pour la deuxième étape
  Elemento=models/vite_coperchio_2.glb                            // Modèle de la deuxième vis
  Utensile=Mani                                            // Outil : toujours manuel pour les vis
  Descrizione=Retirez la deuxième vis du couvercle        // Description pour l'utilisateur
  Azione1=svita
  Azione2=appoggia(0.2)
Autoaction=true
  [Next Step - Troisième vis]                                    // Troisième étape : vis angle inférieur gauche
  HighlightDescription=false
  Elemento=models/vite_coperchio_3.glb                            // Modèle de la troisième vis
  Utensile=Mani                                            // Outil : opération manuelle
  Descrizione=Retirez la troisième vis du couvercle          // Instruction pour l'opérateur
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step - Quatrième vis]                                   // Quatrième étape : dernière vis angle inférieur droit
  HighlightDescription=false
  Elemento=models/vite_coperchio_4.glb                            // Modèle de la dernière vis du couvercle
  Utensile=Mani                                            // Outil : opération manuelle
  Descrizione=Retirez la quatrième vis du couvercle         // Instruction finale pour les vis
  Azione1=svita
  Azione2=traslazione:( 0,0,-0.1,0.2)
  Azione3=appoggia(0.2)
Autoaction=true
  [Next Step- Couvercle]                                     // Cinquième étape : retrait du couvercle complet
  HighlightDescription=true
  Elemento=models/coperchio.glb                                   // Modèle du couvercle de la pompe
  Utensile=Mani                                            // Outil : soulèvement manuel
  Descrizione=Retirez le couvercle du filtre              // Instruction pour le retrait du couvercle
  Azione1=traslazione:(-0.5,0,0.5,0.8)
  Azione2=centro:(0,0.1,0);rotazione:(0,0,-90,0.8)                       // Extraction du couvercle 0.4 unités en 1.5 secondes
  Azione3=appoggia(0.5)




[Next Step - Filtre]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
Elemento=models/filtro.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le filtre                           // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.5)
  Azione2=traslazione:(0,0,0.5,1.5)
  Azione3=appoggia(1.5)
  //Azione=estrai                                           // Animation : extraction linéaire sans rotation
  //Distanza=0.4                                            // Distance d'extraction (filtre compact)
  //Durata=1.5                                              // Durée personnalisée : extraction rapide

 [Next Step - Air comprimé]
 HighlightDescription=true
 Elemento=models/filtro.glb
  Descrizione=Nettoyez le filtre avec de l'air comprimé
  CameraPos=(-0.2,0.33,0.74)                                      // Position absolue pour test
  CameraTarget=filtro                                  // Focus sur le centre de scène légèrement surélevé
  CameraZoom=0.5                                               // Zoom léger pour une vue d'ensemble
  CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce
  Utensile=Aria
  Azione1=traslazione:(0,0.01,0,0.5)
  Azione2=appoggia(0.5)

[Next Step- Bouchon droit]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
  CameraTarget=tappino_grasso_dx                                    // Focus sur le centre de scène légèrement surélevé
  CameraZoom=0.5                                           // Zoom léger pour une vue d'ensemble
  CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce

  Elemento=models/tappino_grasso_dx.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le bouchon de protection du raccord de graissage droit       // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Extraction du bouchon 0.3 unités
  Azione2=appoggia(0.5)


[Next Step - Bouchon gauche]                                        // Sixième étape : extraction du filtre usé
HighlightDescription=true
CameraPos=(-1.5, 0.5,-0.2)                                       // Position absolue pour test
  CameraTarget=tappino_grasso_sx                                    // Focus sur le centre de scène légèrement surélevé
  CameraZoom=0.5                                           // Zoom léger pour une vue d'ensemble
  CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce
  Elemento=models/tappino_grasso_sx.glb                                     // Modèle 3D du filtre à remplacer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Retirez le bouchon de protection du raccord de graissage gauche       // Instruction pour le retrait du filtre
  Azione1=traslazione:(-0.3,0,0,1.0)                       // Extraction du bouchon 0.3 unités
  Azione2=appoggia(0.5)


[Next Step - Pompe à graisse]                                        // Neuvième étape : déplacement du graisseur
HighlightDescription=false
Elemento=models/ingrassatore.glb                                     // Modèle 3D du graisseur à animer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Prenez la pompe à graisse        // Instruction pour le déplacement
  Azione1=traslazione:(0,0.1,0,0.8)
  Azione2=centro:(-0.1,0,0);rotazione:(0,0,90,0.8)
  Azione3=traslazione:(-0.2,0.0,0,0.8)
  Azione4=appoggia(0.5)
  //CameraPos=ingrassatore:(-1, 0, 0)                    // Position relative au graisseur
  //CameraTarget=ingrassatore                               // Focus direct sur le graisseur
  //CameraZoom=2.2                                          // Zoom élevé pour opération de précision
  //CameraTransitionTime=1.2                                // Transition avec transition douce

[Next Step - Pompe à graisse 2]                                        // Dixième étape : déplacement du graisseur
HighlightDescription=true
CameraPos=(-0.42, 0.33,  0.3 )
  CameraTarget=(-0.28, 0.25,-0.16)                                       // Position absolue pour test
  CameraZoom=0.5                                           // Zoom léger pour une vue d'ensemble
  CameraTransitionTime=2.5                                      // Mouvement fluide avec transition douce


  Elemento=models/ingrassatore.glb                                     // Modèle 3D du graisseur à animer
  Utensile=Mani                                           // Outil : extraction manuelle
  Descrizione=Appliquez de la graisse au raccord de graissage droit en pompant 10 fois     // Instruction pour le déplacement
