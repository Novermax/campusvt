[step "Positionner la bride"]
description = Faites glisser la bride et positionnez-la au-dessus de son siège (elle se verrouille automatiquement à 0.3m de hauteur).
tool        = hand
camera      = position (0, 0.45, 0.89), target (0, 0, 0), zoom 1.2, fade 1.5
drag        = flangia distance 0.3 snap pivot (0.000, 0.0, 0.3)

[step "Abaisser la bride" highlight]
description = La bride sera maintenant automatiquement abaissée dans sa position finale.
tool        = hand
element     = flangia
do          : move by (0.0, 0.0, -0.3) duration 0.8

