do          : unscrew distance 0.1
do          : place duration 0.2

[step "Traslazione flangia" highlight]
camera      = zoom 1
element     = flangia
description = Allontana la flangia con le Mani. Il tubo del grasso si muove insieme ad essa.
tool        = hand
companion   = tubograsso follows master
do          : move by (0, 0, 0.2) duration 0.5

[step "Staccare il tubo del grasso" highlight]
