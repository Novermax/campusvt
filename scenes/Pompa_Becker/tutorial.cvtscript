[step "Istruzioni smontaggio flangia" highlight]
message     = Prendi due viti da 8mm e inseriscile nelle apposite sedi per utilizzarle come estrattore.
title       = Importante
video       = media/estrattore.mp4
description = Fase estrazione flangia con viti estrattore
camera      = position (0, 0.45, 0.89), zoom 1
tool        = hand
drag        = vite_culatta_1, vite_culatta_2 distance 0 snap targets estrattoresx_original, estrattoredx_original

[step "Stringi viti estrattore" highlight]

camera      = position (-0.01, 0.34, 0.41), target (-0.03, 0.24, 0.27), pivot (-0.03, 0.24, 0.27), zoom 0.17, fov 75, rotation (-0.64, 0.13, 0.09), fade 1.0
description = Stringi la vite culatta 1 con la chiave a brugola
tool        = hex_key
element     = vite_culatta_1
