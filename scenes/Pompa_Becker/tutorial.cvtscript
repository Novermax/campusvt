[Riassemblaggio]
HighlightDescription=true
# Tutorial inverso - sequenza di rimontaggio
# Sequenza per rimontare il filtro e richiudere la pompa

# Configurazione camera
CameraPos=(-1.5, 0.5, -0.2)
CameraTarget=(0, 0, 0)
CameraZoom=1.2
CameraTransitionTime=2.5

# IMPORTANTE: Disabilita auto-completion per tutorial multi-step
//AutoComplete=false
TutorialSteps=5

# Posizionamento modelli per assemblaggio - Posizioni custom corrette
# IMPORTANTE: I pezzi partono "smontati" come alla fine della pulizia

# Modello 1: coperchio
Posizione=coperchio:(-1.148,-0.261,0.500)
Rotazione=coperchio:(0.0,0.0,-90.0)

# Modello 2: filtro
Posizione=filtro:(-0.300,-0.142,0.500)
Rotazione=filtro:(0.0,0.0,0.0)

# Modello 3: pavimento
Posizione=pavimento:(0.000,0.000,0.000)
Rotazione=pavimento:(0.0,0.0,0.0)

# Modello 4: vite_coperchio_1
Posizione=vite_coperchio_1:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_1:(-360.0,0.0,0.0)

# Modello 5: vite_coperchio_2
Posizione=vite_coperchio_2:(-0.500,-0.349,0.000)
Rotazione=vite_coperchio_2:(-360.0,0.0,0.0)

# Modello 6: vite_coperchio_3
Posizione=vite_coperchio_3:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_3:(-360.0,0.0,0.0)

# Modello 7: vite_coperchio_4
Posizione=vite_coperchio_4:(-0.500,-0.117,-0.100)
Rotazione=vite_coperchio_4:(-360.0,0.0,0.0)

# Modello 8: tappino_grasso_sx
Posizione=tappino_grasso_sx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_sx:(0.0,0.0,0.0)

# Modello 9: tappino_grasso_dx
Posizione=tappino_grasso_dx:(-0.300,-0.243,0.000)
Rotazione=tappino_grasso_dx:(0.0,0.0,0.0)

# Modello 10: ingrassatore
Posizione=ingrassatore:(-0.208,0.243,0)
Rotazione=ingrassatore:(0.0,0.0,90.0)


[Step 1 - Tappini Ingrassatori]
HighlightDescription=true
Descrizione=Monta i tappini degli ingrassatori in qualsiasi ordine. Puoi iniziare dal destro o dal sinistro.
Utensile=Mani

# Nodo intercambiabile - ordine libero per i tappini (NO Elemento specifico)
DragDrop=true
AssemblyMode=true
AllowedComponents=tappino_grasso_dx,tappino_grasso_sx
DragDropDistance=0.2



[Next Step - Filtro]
HighlightDescription=true
Descrizione=Inserisci il filtro nella sua sede.
Utensile=Mani

# Sistema assemblaggio sequenziale - filtro
DragDrop=true
AssemblyMode=true
# Solo il filtro è montabile in questo step
AllowedComponents=filtro
DragDropDistance=0.3


[Next Step - Coperchio]
HighlightDescription=true

Descrizione=Posiziona il coperchio sopra il filtro.
Utensile=Mani

# Continua assemblaggio sequenziale - coperchio
DragDrop=true
AssemblyMode=true


AllowedComponents=coperchio
DragDropDistance=0.3



[Next Step - Gruppo Viti Coperchio]
HighlightDescription=true

Descrizione=Monta le 4 viti del coperchio in qualsiasi ordine.
Utensile=Mani

# Nodo intercambiabile - ordine libero per le viti
DragDrop=true
AssemblyMode=true



AllowedComponents=vite_coperchio_1,vite_coperchio_2,vite_coperchio_3,vite_coperchio_4


DragDropDistance=0.2

ValidateAssembly=true



[Next Step - Ingrassatore Finale]
HighlightDescription=true

Descrizione=Infine, riponi l'ingrassatore nella posizione di riposo. Richiede che tutte le viti siano montate.
Utensile=Mani

# Step finale - richiede tutti i prerequisiti
DragDrop=true
AssemblyMode=true


AllowedComponents=ingrassatore
DragDropDistance=0.3






  
[Sostituzione Palette Smontaggio] 
HighlightDescription=true                                 // Tutorial futuro per sostituzione palette pompa
CameraPos=(0, 0.5,1)                                       // Posizione assoluta per test
  CameraTarget=(0, 0, 0)                                    // Focus su centro scena leggermente rialzato
  CameraZoom=1.2                                                // Zoom leggero per visione d''insieme
  CameraTransitionTime=2.5                                      // Movimento fluido con easing dolce
  Azione1=resetCenteredOriginal


