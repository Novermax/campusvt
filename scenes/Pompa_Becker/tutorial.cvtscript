# TUTORIAL 3: Sostituzione Palette Smontaggio
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

[section "Sostituzione Palette Smontaggio"]
camera = position (-0.08, 0.34, 0.8), target (-0.03, 0.24, 0.27), rotation (-0.2, -0.09, -0.02), pivot (-0.03, 0.24, 0.27), distance 0.54, fov 75, fade 1.0
do     : idle reset

[step "Rimuovi vite 1 culatta" highlight]
element     = vite_culatta_1
description = Rimuovi la prima vite a brugola della culatta con la chiave a brugola da 6mm.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Rimuovi vite 2 culatta" auto]
element     = vite_culatta_2
description = Rimuovi la seconda vite a brugola della culatta con la chiave a brugola da 6mm.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Rimuovi vite 3 culatta" auto]
element     = vite_culatta_3
description = Rimuovi la terza vite a brugola della culatta con la chiave a brugola da 6mm. Nota che le viti più in basso sono più corte
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Rimuovi vite 4 culatta" auto]
element     = vite_culatta_4
description = Rimuovi la quarta vite a brugola della culatta con la chiave a brugola da 6mm. Nota che le viti più in basso sono più corte
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Rimuovi la culatta"]
element     = culatta
description = Rimuovi la culatta della pompa con lo strumento "Mano".
tool        = hand
do          : move by (0.5, 0, 0.5) duration 0.5
do          : rotate by (-90, 0, 0) duration 0.8
do          : place duration 0.2

[step "Rimuovi vite 1 flangia" highlight]
element     = vite_flangia_1
description = Rimuovi la prima vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Rimuovi vite 2 flangia" auto]
element     = vite_flangia_2
description = Rimuovi la seconda vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Rimuovi vite 3 flangia" auto]
element     = vite_flangia_3
description = Rimuovi la terza vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Rimuovi vite 4 flangia" auto]
element     = vite_flangia_4
description = Rimuovi la quarta vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Rimuovi vite 5 flangia" auto]
element     = vite_flangia_5
description = Rimuovi la quinta vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Rimuovi vite 6 flangia" auto]
element     = vite_flangia_6
description = Rimuovi la sesta vite a testa esagonale con la chiave aperta da 10 mm
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
