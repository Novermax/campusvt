camera = position (-0.65, 0.2, 1.11), target (0, 0, 0), rotation (-0.18, -0.52, -0.09), pivot (0, 0, 0), distance 1.3, fov 75, fade 1.0

# Posizioni e Rotazioni Modelli - Esportate automaticamente
