# Tutorial Wartung Vakuumpumpe
# Geführte Sequenz für den Filterwechsel und die Schmierung der Vakuumpumpe Becker U5.40
# Syntax: CVTScript v3

[scene]
camera   = position (-1.5, 0.5, -0.2), target (0, 0, 0), zoom 1.2, fade 2.5
position = planaxis at (-0.5, 0.01, -0.5)


# ════════════════════════════════════════════════════════════════════════════════
# TUTORIAL 1: Filterreinigung und Schmierung
# ════════════════════════════════════════════════════════════════════════════════

[section "Filterreinigung und Schmierung"]
do : idle reset

[step "Erste Schraube" highlight]
element     = vite_coperchio_1
tool        = hand
description = Wählen Sie das Werkzeug „Hand" und entfernen Sie die erste Abdeckschraube.
do          : unscrew
do          : place duration 0.2

[step "Zweite Schraube" auto]
element     = vite_coperchio_2
tool        = hand
description = Entfernen Sie die zweite Abdeckschraube.
do          : unscrew
do          : place duration 0.2

[step "Dritte Schraube" auto]
element     = vite_coperchio_3
tool        = hand
description = Entfernen Sie die dritte Abdeckschraube.
do          : unscrew
do          : move by (0, 0, -0.1) duration 0.2
do          : place duration 0.2

[step "Vierte Schraube" auto]
element     = vite_coperchio_4
tool        = hand
description = Entfernen Sie die vierte Abdeckschraube.
do          : unscrew
do          : move by (0, 0, -0.1) duration 0.2
do          : place duration 0.2

[step "Deckel" highlight]
element     = coperchio
tool        = hand
description = Entfernen Sie den Filterdeckel.
do          : move by (-0.5, 0, 0.5) duration 0.8
do          : rotate around (0, 0.1, 0) by (0, 0, -90) duration 0.8
do          : place duration 0.5

[step "Filter" highlight]
element     = filtro
tool        = hand
description = Entnehmen Sie den Filter.
do          : move by (-0.3, 0, 0) duration 1.5
do          : move by (0, 0, 0.5) duration 1.5
do          : place duration 1.5

[step "Druckluft" highlight]
element     = filtro
description = Reinigen Sie den Filter mit Druckluft.
camera      = position (-0.2, 0.33, 0.74), target filtro, zoom 0.5
tool        = air
do          : move by (0, 0.01, 0) duration 0.5
do          : place duration 0.5

[step "Rechte Kappe" highlight]
camera      = position (-1.5, 0.5, -0.2), target tappino_grasso_dx, zoom 0.5, fade 2.5
element     = tappino_grasso_dx
tool        = hand
description = Entfernen Sie die Schutzkappe des rechten Schmiernippels.
do          : move by (-0.3, 0, 0) duration 1.0
do          : place duration 0.5

[step "Linke Kappe" highlight]
camera      = position (-1.5, 0.5, -0.2), target tappino_grasso_sx, zoom 0.5, fade 2.5
element     = tappino_grasso_sx
tool        = hand
description = Entfernen Sie die Schutzkappe des linken Schmiernippels.
do          : move by (-0.3, 0, 0) duration 1.0
do          : place duration 0.5

[step "Fettpresse" highlight]
element     = ingrassatore
tool        = hand
description = Nehmen Sie die Fettpresse auf.
do          : move by (0, 0.1, 0) duration 0.8
do          : rotate around (-0.1, 0, 0) by (0, 0, 90) duration 0.8
do          : move by (-0.2, 0, 0) duration 0.8
do          : place duration 0.5

[step "Rechter Schmiernippel" highlight]
camera      = position (-0.42, 0.33, 0.3), target (-0.28, 0.25, -0.16)
element     = ingrassatore
tool        = hand
description = Fetten Sie den rechten Schmiernippel durch 10-maliges Pumpen.
do          : move from tappino_grasso_dx_original by (-0.2, 0, 0) duration 0.5
do          : pump from tappino_grasso_dx_original between (-0.08, 0, 0) and (-0.09, 0, 0) cycles 10 duration 0.1
do          : move from tappino_grasso_dx_original by (-0.2, 0, 0) duration 0.5

[step "Linker Schmiernippel"]
element     = ingrassatore
tool        = hand
description = Fetten Sie den linken Schmiernippel durch 10-maliges Pumpen.
do          : move from tappino_grasso_sx_original by (-0.2, 0, 0) duration 0.5
do          : pump from tappino_grasso_sx_original between (-0.08, 0, 0) and (-0.09, 0, 0) cycles 10 duration 0.1
do          : move from tappino_grasso_sx_original by (-0.2, 0, 0) duration 0.5
do          : move from ingrassatore_original by (-0.2, 0, 0) duration 0.5
do          : place duration 0.5


# ════════════════════════════════════════════════════════════════════════════════
# TUTORIAL 2: Wiedermontage
# ════════════════════════════════════════════════════════════════════════════════

[section "Wiedermontage"]
camera   = position (-1.5, 0.5, -0.2), target (0, 0, 0), zoom 1.2, fade 2.5

position = coperchio at (-1.148, -0.261, 0.500)
rotation = coperchio by (0.0, 0.0, -90.0)
position = filtro at (-0.300, -0.142, 0.500)
rotation = filtro by (0.0, 0.0, 0.0)
position = pavimento at (0.000, 0.000, 0.000)
rotation = pavimento by (0.0, 0.0, 0.0)
position = vite_coperchio_1 at (-0.500, -0.349, 0.000)
rotation = vite_coperchio_1 by (-360.0, 0.0, 0.0)
position = vite_coperchio_2 at (-0.500, -0.349, 0.000)
rotation = vite_coperchio_2 by (-360.0, 0.0, 0.0)
position = vite_coperchio_3 at (-0.500, -0.117, -0.100)
rotation = vite_coperchio_3 by (-360.0, 0.0, 0.0)
position = vite_coperchio_4 at (-0.500, -0.117, -0.100)
rotation = vite_coperchio_4 by (-360.0, 0.0, 0.0)
position = tappino_grasso_sx at (-0.300, -0.243, 0.000)
rotation = tappino_grasso_sx by (0.0, 0.0, 0.0)
position = tappino_grasso_dx at (-0.300, -0.243, 0.000)
rotation = tappino_grasso_dx by (0.0, 0.0, 0.0)
position = ingrassatore at (-0.208, 0.243, 0)
rotation = ingrassatore by (0.0, 0.0, 90.0)

[step "Rechte Kappe" highlight]
camera      = position (-1.03, 0.27, 0.03), target (-0.17, 0.14, -0.01), rotation (-1.3, -1.41, -1.3), pivot (-0.17, 0.14, -0.01), distance 0.86, fov 75, fade 1.0
description = Montieren Sie die rechte Schmiernippelkappe.
tool        = hand
drag        = tappino_grasso_dx distance 0.2

[step "Linke Kappe" highlight]
camera      = target tappino_grasso_sx
description = Montieren Sie die linke Schmiernippelkappe.
tool        = hand
drag        = tappino_grasso_sx distance 0.2

[step "Filter" highlight]
camera      = position (-1.38, 0.5, 0.27), target (-0.58, 0.01, -0.16), rotation (-0.86, -0.88, -0.73), pivot (-0.58, 0.01, -0.16), distance 1.03, fov 75, fade 1.0
description = Setzen Sie den Filter in sein Gehäuse ein.
tool        = hand
drag        = filtro distance 0.3

[step "Deckel" highlight]
description = Positionieren Sie den Deckel über dem Filter.
tool        = hand
drag        = coperchio distance 0.3

[step "Abdeckschrauben-Gruppe" highlight]
camera      = position (-1.14, 0.27, -0.04), target (-0.32, 0, -0.01), rotation (-1.67, -1.25, -1.67), pivot (-0.32, 0, -0.01), distance 0.86, fov 75, fade 1.0
description = Montieren Sie die 4 Abdeckschrauben in beliebiger Reihenfolge.
tool        = hand
drag        = vite_coperchio_1, vite_coperchio_2, vite_coperchio_3, vite_coperchio_4 distance 0.2

[step "Fettpresse zurücksetzen" highlight]
description = Legen Sie die Fettpresse abschließend zurück in die Ruheposition. Alle Schrauben müssen montiert sein.
tool        = hand
drag        = ingrassatore distance 0.3


# ════════════════════════════════════════════════════════════════════════════════
# TUTORIAL 3: Schaufelersatz – Demontage
# ════════════════════════════════════════════════════════════════════════════════

[section "Schaufelersatz – Demontage"]
camera = position (-0.08, 0.34, 0.8), target (-0.03, 0.24, 0.27), rotation (-0.2, -0.09, -0.02), pivot (-0.03, 0.24, 0.27), distance 0.54, fov 75, fade 1.0
do     : idle reset

[step "Zylinderkopfschraube 1 entfernen" highlight]
element     = vite_culatta_1
description = Entfernen Sie die erste Inbusschraube des Zylinderkopfs mit dem 6-mm-Inbusschlüssel.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Zylinderkopfschraube 2 entfernen" auto]
element     = vite_culatta_2
description = Entfernen Sie die zweite Inbusschraube des Zylinderkopfs mit dem 6-mm-Inbusschlüssel.
tool        = hex_key
do          : unscrew distance 0.3
do          : place duration 0.2

[step "Zylinderkopfschraube 3 entfernen" auto]
element     = vite_culatta_3
description = Entfernen Sie die dritte Inbusschraube des Zylinderkopfs mit dem 6-mm-Inbusschlüssel. Die unteren Schrauben sind kürzer.
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Zylinderkopfschraube 4 entfernen" auto]
element     = vite_culatta_4
description = Entfernen Sie die vierte Inbusschraube des Zylinderkopfs mit dem 6-mm-Inbusschlüssel. Die unteren Schrauben sind kürzer.
tool        = hex_key
do          : unscrew distance 0.3
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Zylinderkopf entfernen"]
element     = culatta
description = Entfernen Sie den Pumpenzylinderkopf mit dem Werkzeug „Hand".
tool        = hand
do          : move by (0.5, 0, 0.5) duration 0.5
do          : rotate by (-90, 0, 0) duration 0.8
do          : place duration 0.2

[step "Flanschschraube 1 entfernen" highlight]
element     = vite_flangia_1
description = Entfernen Sie die erste Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Flanschschraube 2 entfernen" auto]
element     = vite_flangia_2
description = Entfernen Sie die zweite Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Flanschschraube 3 entfernen" auto]
element     = vite_flangia_3
description = Entfernen Sie die dritte Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Flanschschraube 4 entfernen" auto]
element     = vite_flangia_4
description = Entfernen Sie die vierte Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Flanschschraube 5 entfernen" auto]
element     = vite_flangia_5
description = Entfernen Sie die fünfte Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Flanschschraube 6 entfernen" auto]
element     = vite_flangia_6
description = Entfernen Sie die sechste Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Flanschschraube 7 entfernen" auto]
element     = vite_flangia_7
description = Entfernen Sie die siebte Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Flanschschraube 8 entfernen" auto]
element     = vite_flangia_8
description = Entfernen Sie die achte Sechskantschraube mit dem 10-mm-Maulschlüssel.
tool        = wrench
do          : unscrew distance 0.1
do          : move by (-0.1, 0, 0) duration 0.2
do          : place duration 0.2

[step "Flansch-Demontage-Anleitung" highlight]
message     = Nehmen Sie zwei 8-mm-Schrauben und setzen Sie sie in die entsprechenden Sitze, um sie als Abzieher zu verwenden.
title       = Wichtig
video       = media/estrattore.mp4
description = Flansch-Abziehphase mit Abzieherschrauben
camera      = position (0, 0.45, 0.89), zoom 1
tool        = hand
drag        = vite_culatta_1, vite_culatta_2 distance 0 snap targets estrattoresx_original, estrattoredx_original

[step "Abzieherschrauben anziehen" highlight]
camera      = position (-0.01, 0.34, 0.41), target (-0.03, 0.24, 0.27), pivot (-0.03, 0.24, 0.27), zoom 0.17, fov 75, rotation (-0.64, 0.13, 0.09), fade 1.0
description = Ziehen Sie Zylinderkopfschraube 1 mit dem Inbusschlüssel an.
tool        = hex_key
element     = vite_culatta_1
do          : screw distance 0.005
companion   = flangia moves by (0, 0, 0.005) duration 0.5
companion   = tubograsso moves by (0, 0, 0.005) duration 0.5

[step "Abzieherschrauben anziehen 2"]
description = Ziehen Sie Zylinderkopfschraube 2 mit dem Inbusschlüssel an.
tool        = hex_key
element     = vite_culatta_2
do          : screw distance 0.005
companion   = flangia moves by (0, 0, 0.005) duration 0.5
companion   = tubograsso moves by (0, 0, 0.005) duration 0.5

[step "Abzieherschraube 2 entfernen"]
element     = vite_culatta_2
description = Entfernen Sie die als Abzieher verwendete Schraube mit dem 6-mm-Inbusschlüssel.
tool        = hex_key
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Abzieherschraube 1 entfernen"]
element     = vite_culatta_1
description = Entfernen Sie die als Abzieher verwendete Schraube mit dem 6-mm-Inbusschlüssel.
tool        = hex_key
do          : unscrew distance 0.1
do          : place duration 0.2

[step "Flansch verschieben" highlight]
camera      = zoom 1
element     = flangia
description = Bewegen Sie den Flansch mit den Händen weg. Das Fettrohr bewegt sich mit ihm.
tool        = hand
companion   = tubograsso follows master
do          : move by (0, 0, 0.2) duration 0.5

[step "Fettrohr abkoppeln" highlight]
element     = tubograsso
description = Koppeln Sie das Fettrohr vom Flansch ab.
tool        = hand
do          : move by (0, 0, -0.2) duration 0.5

[step "Flansch entnehmen" highlight]
element     = flangia
description = Legen Sie den Flansch auf den Boden.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (90, 0, 0) duration 0.5
do          : place duration 0.2

[step "Schaufel 1 entnehmen" highlight]
camera      = position (0.14, 0.96, 1.21), target (-0.03, 0.24, 0.27), rotation (-0.65, 0.14, 0.11), pivot (-0.03, 0.24, 0.27), distance 1.2, fov 75, fade 1.0
element     = paletta1
description = Legen Sie Schaufel 1 auf den Boden.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -32) duration 0.5
do          : move by (-0.5, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Schaufel 2 entnehmen" auto]
element     = paletta2
description = Legen Sie Schaufel 2 auf den Boden.
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -108) duration 0.5
do          : move by (-0.7, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Schaufel 3 entnehmen" auto]
element     = paletta3
description = Legen Sie Schaufel 3 auf den Boden.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, 0) duration 0.5
do          : move by (-0.9, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Schaufel 4 entnehmen" auto]
element     = paletta4
description = Legen Sie Schaufel 4 auf den Boden.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, -72) duration 0.5
do          : move by (-1.1, 0, 0.2) duration 0.5
do          : place duration 0.2

[step "Schaufel 5 entnehmen" auto]
element     = paletta5
description = Legen Sie Schaufel 5 auf den Boden.
tool        = hand
do          : move by (0, 0, 0.5) duration 0.5
do          : rotate by (0, 0, 32) duration 0.5
do          : move by (-1.3, 0, 0.2) duration 0.5
do          : place duration 0.2


