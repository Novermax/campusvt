[step "Schaufel 4 einsetzen" auto]
description = Nehmen Sie Schaufel 4 und setzen Sie sie an ihrer ursprünglichen Position ein. Die Schaufel wird automatisch gedreht und positioniert.
tool        = hand
element     = paletta4
rotation    = paletta4 by (0.0, 0.0, 0.0)
do          : move by (1.337, 0.082, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Schaufel 5 einsetzen" auto]
description = Nehmen Sie Schaufel 5 und setzen Sie sie an ihrer ursprünglichen Position ein. Die Schaufel wird automatisch gedreht und positioniert.
tool        = hand
element     = paletta5
rotation    = paletta5 by (0.0, 0.0, 0.0)
do          : move by (1.188, 0.151, -0.300) duration 1.2
do          : move by (0.0, -0.0, -0.400) duration 1.2

[step "Flansch positionieren"]
description = Ziehen Sie den Flansch und positionieren Sie ihn über seinem Sitz (er rastet automatisch ein, wenn er 0,3 m angehoben wird).
tool        = hand
camera      = position (0, 0.45, 0.89), target (0, 0, 0), zoom 1.2, fade 1.5
drag        = flangia distance 0.3 snap pivot (0.000, 0.0, 0.3)

[step "Flansch absenken" highlight]
description = Der Flansch wird nun automatisch in seine endgültige Position abgesenkt.
tool        = hand
element     = flangia
do          : move by (0.0, 0.0, -0.3) duration 0.8

[step "Flanschschraube 1 einsetzen" highlight]
description = Setzen Sie die erste Flanschschraube in ihren Sitz.
tool        = hand
camera      = position (0.01, 0.54, 0.79), target (0, 0.15, 0.19), rotation (-0.58, 0.02, 0.01), pivot (0, 0.15, 0.19), distance 0.72, fov 60, fade 1.0
drag        = vite_flangia_1 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 2 einsetzen" auto]
description = Setzen Sie die zweite Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_2 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 3 einsetzen" auto]
description = Setzen Sie die dritte Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_3 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 4 einsetzen" auto]
description = Setzen Sie die vierte Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_4 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 5 einsetzen" auto]
description = Setzen Sie die fünfte Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_5 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 6 einsetzen" auto]
description = Setzen Sie die sechste Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_6 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 7 einsetzen" auto]
description = Setzen Sie die siebte Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_7 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 8 einsetzen" auto]
description = Setzen Sie die achte Flanschschraube in ihren Sitz.
tool        = hand
drag        = vite_flangia_8 distance 1.5 snap offset (0, 0, 0.01)

[step "Flanschschraube 1 festziehen" highlight]
element     = vite_flangia_1
description = Kreuzsequenz (1/8): Schraube 1 mit dem 10-mm-Schlüssel anziehen.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 5 festziehen"]
element     = vite_flangia_5
description = Kreuzsequenz (2/8): Schraube 5 anziehen – gegenüber 1.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 3 festziehen"]
element     = vite_flangia_3
description = Kreuzsequenz (3/8): Schraube 3 anziehen.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 7 festziehen"]
element     = vite_flangia_7
description = Kreuzsequenz (4/8): Schraube 7 anziehen – gegenüber 3.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 2 festziehen"]
element     = vite_flangia_2
description = Kreuzsequenz (5/8): Schraube 2 anziehen.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 6 festziehen"]
element     = vite_flangia_6
description = Kreuzsequenz (6/8): Schraube 6 anziehen – gegenüber 2.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 4 festziehen"]
element     = vite_flangia_4
description = Kreuzsequenz (7/8): Schraube 4 anziehen.
tool        = wrench
do          : screw distance 0.01

[step "Flanschschraube 8 festziehen"]
element     = vite_flangia_8
description = Kreuzsequenz (8/8): Schraube 8 anziehen – gegenüber 4.
tool        = wrench
do          : screw distance 0.01

[step "Fettrohr wiederanbringen"]
description = Verbinden Sie das Fettrohr mit dem Flansch. Der Flansch muss bereits montiert sein.
tool        = hand
drag        = tubograsso distance 0.3

[step "Zylinderkopf einsetzen" highlight]
camera      = position (-0.35, 0.42, 0.92), target (0.3, 0.12, 0.1), rotation (-0.35, -0.64, -0.22), pivot (0.3, 0.12, 0.1), distance 1.08, fov 75
description = Positionieren Sie den Zylinderkopf auf dem Pumpengehäuse. Alle Flanschschrauben müssen angezogen sein.
tool        = hand
drag        = culatta distance 0.3

[step "Lange Zylinderkopfschrauben einsetzen" highlight]
description = Setzen Sie die 2 langen Zylinderkopfschrauben in beliebiger Reihenfolge in ihre Sitze. Die Schrauben werden noch nicht angezogen.
tool        = hand
drag        = vite_culatta_1, vite_culatta_2 distance 1.5 snap offset (0, 0, 0.02)

[step "Kurze Zylinderkopfschrauben einsetzen" highlight]
description = Setzen Sie die 2 kurzen Zylinderkopfschrauben in beliebiger Reihenfolge in ihre Sitze. Die Schrauben werden noch nicht angezogen.
tool        = hand
drag        = vite_culatta_3, vite_culatta_4 distance 1.5 snap offset (0, 0, 0.02)

[step "Zylinderkopfschraube 1 festziehen" highlight]
element     = vite_culatta_1
description = Ziehen Sie die erste Zylinderkopfschraube mit dem 6-mm-Inbusschlüssel an.
tool        = hex_key
do          : screw distance 0.02

[step "Zylinderkopfschraube 2 festziehen" auto]
element     = vite_culatta_2
description = Ziehen Sie die zweite Zylinderkopfschraube mit dem 6-mm-Inbusschlüssel an.
tool        = hex_key
do          : screw distance 0.02

[step "Zylinderkopfschraube 3 festziehen" auto]
element     = vite_culatta_3
description = Ziehen Sie die dritte Zylinderkopfschraube mit dem 6-mm-Inbusschlüssel an.
tool        = hex_key
do          : screw distance 0.02

[step "Zylinderkopfschraube 4 festziehen" auto]
element     = vite_culatta_4
description = Ziehen Sie die vierte Zylinderkopfschraube mit dem 6-mm-Inbusschlüssel an. Damit ist die Pumpenmontage abgeschlossen.
tool        = hex_key
do          : screw distance 0.02
