[step "Schaufel 1 einsetzen" highlight]
description = Nehmen Sie Schaufel 1 und setzen Sie sie an ihrer ursprünglichen Position ein. Die Schaufel wird automatisch gedreht und positioniert.
tool        = hand
element     = paletta1
rotation    = paletta1 by (0.0, 0.0, 0.0)
do          : move by (0.625, 0.156, -0.300) duration 1.2
do          : move by (0, 0, -0.4) duration 1.2

[step "Schaufel 2 einsetzen" auto]
camera      = position (-0.45, 0.45, 1.3), target (-0.7, 0.05, 0.61), rotation (-0.53, 0.31, 0.18), pivot (-0.7, 0.05, 0.61), distance 0.83, fov 75, fade 1.0, zoom 1
