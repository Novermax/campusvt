BackLight=0xffffff,1.0,(-8, 12, 7)                       // Lumière pour réduire les contrastes excessifs
// === INFORMATIONS DU SCÉNARIO ===
description=Non-activé
description_key=Grease_tank_feed_description        // Clé i18n pour le calibrage géométrique de la machine
