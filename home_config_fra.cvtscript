direction=0,0,1                                        // Direction de mouvement : vers Z+
model=models/tubograsso.glb                                    // Tube de graisse de la pompe
direction=0,0,1                                        // Direction de mouvement : vers Z+

[Graissage Unité de Perçage]                                   // Graissage du perçage
// === CONFIGURATION CAMÉRA ET LUMIÈRES ===
CameraPos=(6, 4, 8)                                      // Vue latérale pour visualiser les zones de vide
CameraTarget=(0, 0, 0)                                   // Focus sur le plan de travail
AmbientLight=0x404040,1.5                                // Lumière pour identifier les zones
DirectionalLight=0xffffff,2.5,(7, 12, 6)                // Éclairage principal du plan
BackLight=0xffffff,1.0,(-7, 12, 6)                       // Lumière pour éliminer les ombres sur le plan
// === INFORMATIONS DU SCÉNARIO ===
description=Non-activé
description_key=Drilling_grease_description         // Clé i18n pour le système de gestion d'aspiration
image=menuimages/placeholder.png                                                                 // Diagramme des zones de vide

[RTCP Automatique]                                           // Système RTCP (Rotation Tool Center Point)
// === CONFIGURATION CAMÉRA ET LUMIÈRES ===
CameraPos=(4, 6, 8)                                      // Vue optimale pour la Tête Prisma
CameraTarget=(0, 0, 0)                                   // Centre sur la tête d'usinage
AmbientLight=0x404040,1.5                                // Éclairage pour les détails mécaniques
DirectionalLight=0xffffff,2.5,(5, 12, 6)                // Lumière pour mettre en évidence la cinématique
BackLight=0xffffff,1.0,(-5, 12, 6)                       // Lumière d'appoint pour la visibilité
// === INFORMATIONS DU SCÉNARIO ===
description=Non-activé
description_key=scenario_automatic_rtcp_description       // Clé i18n pour le calibrage automatique de rotation d'outil
image=menuimages/placeholder.png
[Rechargement Réservoir de Graisse]                                       // Alimentation du réservoir de graisse
// === CONFIGURATION CAMÉRA ET LUMIÈRES ===
