# Configuration Page d'Accueil - Campus Virtual Training Morbidelli X400
# Ce fichier définit les scénarios disponibles et leurs configurations
# VERSION REFACTORISÉE avec variables en anglais et clés i18n

title=Campus Virtual Training Morbidelli X400
subtitle=Sélectionnez un scénario de simulation pour démarrer la démonstration

[Maintenance Électrobroche]                                 // Nom du scénario (affiché comme titre de la carte)
// === CONFIGURATION CAMÉRA ET LUMIÈRES ===
CameraPos=(-1.11, 1.44, 3.97)                               // Caméra positionnée plus loin pour un cadrage complet
CameraTarget=(0, 0, 0)                                    // La caméra pointe vers le centre de la scène
AmbientLight=0xffffff,1.05                                 // Lumière ambiante pour l'éclairage général
DirectionalLight=0xffffff,1.05,(-8, 15, 0)               // Lumière directionnelle principale depuis le haut à droite
BackLight=0xffffff,2,(-8, 15,  5 )                      // Contre-jour pour éliminer les ombres dures

// === INFORMATIONS DU SCÉNARIO ===
description=Contrôle et maintenance de l'électrobroche avec cônes HSK : nettoyage de la pince, lubrification, déverrouillage/verrouillage manuel de la pince.
description_key=scenario_spindle_maintenance_description   // Clé i18n pour la description
image=menuimages/1.png                                    // Image d'aperçu du scénario
tutorial=scenes/Manutenzione_Elettromandrino/tutorial_fra.cvtscript
Configuration=scenes/Manutenzione_Elettromandrino/config.cvtscript
// === MODÈLES 3D ET DIRECTIONS DE MOUVEMENT ===
model=models/pulpito.glb                                  // Modèle 3D du pupitre
direction=0,0,1                                           // Direction de mouvement : vers Z+ (si nécessaire)
// === MODÈLES 3D ET DIRECTIONS DE MOUVEMENT ===
model=models/remote.glb                                  // Modèle 3D de la télécommande
direction=0,0,1                                           // Direction de mouvement : vers Z+ (si nécessaire)
model=models/a500.glb                                  // Modèle 3D de la machine
direction=0,0,1                                           // Direction de mouvement : vers Z+ (si nécessaire)
model=models/pavimento.glb                                // Modèle 3D de la base/sol (statique)
direction=0,0,1                                           // Direction de mouvement : vers Z+ (si nécessaire)

[Maintenance Pompe à Vide]                                  // Scénario principal avec tutoriel complet
// === CONFIGURATION CAMÉRA ET LUMIÈRES ===
CameraPos=(-1.5, 0.5,-0.2)                               // Caméra positionnée plus loin pour un cadrage complet
CameraTarget=(0, 0, 0)                                    // La caméra pointe vers le centre de la scène
AmbientLight=0x404040,1.5                                 // Lumière ambiante pour l'éclairage général
DirectionalLight=0xffffff,2.5,(-8, 15, 10)               // Lumière directionnelle principale depuis le haut à droite
BackLight=0xffffff,1.0,(-8, 15, 10)                      // Contre-jour pour éliminer les ombres dures
// === INFORMATIONS DU SCÉNARIO ===
description=Démontage complet et maintenance de la pompe à vide Becker avec remplacement du filtre à air et des composants internes.
description_key=scenario_pump_maintenance_description      // Clé i18n pour la description de l'opération technique
image=menuimages/pompavuoto.png                           // Image spécifique de la pompe à vide
tutorial=scenes/Pompa_Becker/tutorial_fra.cvtscript                // Fichier tutoriel avec étapes guidées
Configuration=scenes/Pompa_Becker/config.cvtscript
// === MODÈLES 3D ET DIRECTIONS DE MOUVEMENT ===
model=models/culatta.glb                                  // Modèle 3D de la culasse
direction=0,0,1                                           // Direction de mouvement : vers Z+ (extraction verticale)
model=models/corpo.glb                                    // Modèle 3D du corps de la pompe
direction=0,0,1                                           // Direction de mouvement : vers Z+
model=models/coperchio.glb                                // Modèle 3D du couvercle
direction=-1,0,1                                          // Direction de mouvement : vers X- et Z+ (diagonal)
model=models/filtro.glb                                   // Modèle 3D du filtre à remplacer
direction=-1,0,0                                          // Direction de mouvement : vers X- (extraction latérale)
model=models/pavimento.glb                                // Modèle 3D de la base/sol (statique)
direction=0,0,1                                           // Direction de mouvement : vers Z+ (si nécessaire)
model=models/planaxis.glb                                     // Axes
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/vite_coperchio_1.glb                         // Première vis du couvercle
direction=-1,0,0                                          // Direction de mouvement : vers X- (dévissage et extraction)
model=models/vite_coperchio_2.glb                         // Deuxième vis du couvercle
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/vite_coperchio_3.glb                         // Troisième vis du couvercle
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/vite_coperchio_4.glb                         // Quatrième vis du couvercle
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/tappino_grasso_sx.glb                        // Bouchon de graissage gauche
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/tappino_grasso_dx.glb                        // Bouchon de graissage droit
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/ingrassatore.glb                             // Graisseur
direction=-1,0,0                                          // Direction de mouvement : vers X-
model=models/vite_culatta_1.glb                         // Première vis de culasse
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/vite_culatta_2.glb                         // Deuxième vis de culasse
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/vite_culatta_3.glb                         // Troisième vis de culasse
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/vite_culatta_4.glb                         // Quatrième vis de culasse
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/estrattoredx.glb                         // Extracteur droit
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/estrattoresx.glb                         // Extracteur gauche
direction=0,0,1                                          // Direction de mouvement : vers X-
model=models/flangia.glb                                    // Modèle 3D du corps de la pompe
direction=0,0,1
model=models/vite_flangia_1.glb                         // Première vis de bride
direction=0,0,1
model=models/vite_flangia_2.glb                         // Deuxième vis de bride
direction=0,0,1
model=models/vite_flangia_3.glb                         // Troisième vis de bride
direction=0,0,1
model=models/vite_flangia_4.glb                         // Quatrième vis de bride
direction=0,0,1
model=models/vite_flangia_5.glb                         // Cinquième vis de bride
direction=0,0,1
model=models/vite_flangia_6.glb                         // Sixième vis de bride
direction=0,0,1
model=models/vite_flangia_7.glb                         // Septième vis de bride
direction=0,0,1
model=models/vite_flangia_8.glb                         // Huitième vis de bride
direction=0,0,1                                      // Direction de mouvement : vers Z+
model=models/paletta1.glb                                    // Palette 1 de la pompe
direction=0,0,1                                        // Direction de mouvement : vers Z+
model=models/paletta2.glb                                    // Palette 2 de la pompe
direction=0,0,1                                        // Direction de mouvement : vers Z+
model=models/paletta3.glb                                    // Palette 3 de la pompe
direction=0,0,1                                        // Direction de mouvement : vers Z+
model=models/paletta4.glb                                    // Palette 4 de la pompe
direction=0,0,1                                        // Direction de mouvement : vers Z+
